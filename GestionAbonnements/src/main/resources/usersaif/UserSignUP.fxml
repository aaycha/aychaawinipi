<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="800.0" prefWidth="1200.0" styleClass="nature-root" stylesheets="@../styles/nature-mood.css" xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gestion.controllers.SignupController">

    <!-- Title Bar -->
    <top>
        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-background-color: transparent; -fx-padding: 15 25 0 0;">
            <Button fx:id="minimizeBtn" onAction="#handleMinimize" styleClass="button-capsule-glass" text="−" prefWidth="40" style="-fx-padding: 5;"/>
            <Button fx:id="maximizeBtn" onAction="#handleMaximize" styleClass="button-capsule-glass" text="□" prefWidth="40" style="-fx-padding: 5;"/>
            <Button fx:id="closeBtn" onAction="#handleClose" styleClass="button-capsule-glass" text="×" prefWidth="40" style="-fx-padding: 5; -fx-background-color: rgba(239, 68, 68, 0.2);"/>
        </HBox>
    </top>

    <!-- Immersion Layer (Background) -->
    <center>
        <StackPane>
            <!-- Background Image -->
            <ImageView fitHeight="1000" fitWidth="1800" preserveRatio="false">
                <image>
                    <Image url="@clayton-manche--HtKP_ke858-unsplash.jpg" />
                </image>
            </ImageView>
            
            <!-- Dark Overlay -->
            <StackPane style="-fx-background-color: rgba(10, 15, 13, 0.7);" />

            <!-- Main Scrollable Content -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="modern-scroll">
                <content>
                    <VBox alignment="CENTER" spacing="40" style="-fx-padding: 30 0 60 0;">
                        
                        <!-- Header Section -->
                        <VBox alignment="CENTER" spacing="10">
                            <ImageView fitHeight="80.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@logo.png" />
                                </image>
                            </ImageView>
                            <Label styleClass="text-hero" text="JOIN THE EXPEDITION" style="-fx-font-size: 32;"/>
                            <Label styleClass="text-muted" text="Create your account to start the adventure" />
                        </VBox>

                        <!-- Signup Card -->
                        <VBox maxWidth="600" spacing="30" styleClass="glass-panel" style="-fx-padding: 45;">
                            
                            <!-- Profile Section -->
                            <VBox alignment="CENTER" spacing="15">
                                <StackPane maxWidth="120" maxHeight="120">
                                    <ImageView fx:id="profileImageView" fitHeight="120" fitWidth="120" pickOnBounds="true" preserveRatio="true" style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 60;">
                                        <!-- Placeholder or default icon -->
                                    </ImageView>
                                </StackPane>
                                <Button fx:id="uploadPhotoBtn" styleClass="button-capsule-glass" text="📷  Upload Scout Photo" />
                            </VBox>

                            <Separator opacity="0.1" />

                            <!-- Form Grid -->
                            <GridPane hgap="25" vgap="25">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="50" />
                                    <ColumnConstraints percentWidth="50" />
                                </columnConstraints>

                                <!-- Username -->
                                <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label style="-fx-text-fill: white; -fx-font-weight: 700;" text="USERNAME" />
                                    <TextField fx:id="UserName" promptText="Your hiker name" styleClass="modern-input" />
                                    <Label fx:id="usernameError" visible="false" style="-fx-text-fill: #fc8181; -fx-font-size: 10;" />
                                </VBox>

                                <!-- Email -->
                                <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label style="-fx-text-fill: white; -fx-font-weight: 700;" text="EMAIL ADDRESS" />
                                    <TextField fx:id="email" promptText="explorer@hiking.com" styleClass="modern-input" />
                                    <Label fx:id="emailError" visible="false" style="-fx-text-fill: #fc8181; -fx-font-size: 10;" />
                                </VBox>

                                <!-- Phone -->
                                <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <Label style="-fx-text-fill: white; -fx-font-weight: 700;" text="PHONE NUMBER" />
                                    <TextField fx:id="phone" promptText="+216 12345678" styleClass="modern-input" />
                                    <Label fx:id="phoneError" visible="false" style="-fx-text-fill: #fc8181; -fx-font-size: 10;" />
                                </VBox>

                                <!-- Motorized -->
                                <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <Label style="-fx-text-fill: white; -fx-font-weight: 700;" text="VEHICLE ACCESS" />
                                    <ComboBox fx:id="motorizedCombo" maxWidth="Infinity" styleClass="modern-input" />
                                </VBox>

                                <!-- Password -->
                                <VBox spacing="8" GridPane.columnSpan="2" GridPane.rowIndex="2">
                                    <Label style="-fx-text-fill: white; -fx-font-weight: 700;" text="PASSWORD" />
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <StackPane HBox.hgrow="ALWAYS">
                                            <PasswordField fx:id="password" promptText="Choose a strong path" styleClass="modern-input" maxWidth="Infinity"/>
                                            <TextField fx:id="passwordVisible" visible="false" promptText="Choose a strong path" styleClass="modern-input" maxWidth="Infinity"/>
                                        </StackPane>
                                        <Button fx:id="togglePasswordBtn" onAction="#togglePasswordVisibility" styleClass="button-capsule-glass" prefHeight="50" prefWidth="50" style="-fx-padding: 0;">
                                            <graphic>
                                                <Label fx:id="eyeIcon" text="👁" style="-fx-text-fill: white; -fx-font-size: 18;"/>
                                            </graphic>
                                        </Button>
                                    </HBox>
                                    <HBox spacing="10">
                                        <Label fx:id="passwordError" visible="false" style="-fx-text-fill: #fc8181; -fx-font-size: 10;" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="passwordStrength" style="-fx-font-size: 10;" />
                                    </HBox>
                                </VBox>
                            </GridPane>

                            <Button fx:id="Signup" maxWidth="Infinity" onAction="#handleSignup" prefHeight="55" styleClass="button-capsule" text="CREATE ADVENTURER ACCOUNT" />

                            <HBox alignment="CENTER" spacing="5">
                                <Label styleClass="text-muted" text="Already have an account?" />
                                <Hyperlink fx:id="loginLink" onAction="#goToLogin" style="-fx-text-fill: white; -fx-font-weight: 900;" text="Back to Base Camp" />
                            </HBox>
                        </VBox>

                    </VBox>
                </content>
            </ScrollPane>
        </StackPane>
    </center>
</BorderPane>
