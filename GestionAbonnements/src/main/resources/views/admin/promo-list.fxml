<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.gestion.ui.admin.PromoCodeManagementController" 
      styleClass="glass-panel" style="-fx-padding: 20;">
    
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Gestion des Codes Promo" styleClass="section-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Actualiser" onAction="#onActualiser" styleClass="button-capsule-glass"/>
    </HBox>

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <!-- TableView -->
        <TableView fx:id="tableView" HBox.hgrow="ALWAYS" styleClass="modern-table">
            <columns>
                <TableColumn fx:id="colCode" text="Code" prefWidth="120"/>
                <TableColumn fx:id="colDiscount" text="Remise (%)" prefWidth="100"/>
                <TableColumn fx:id="colExpiry" text="Expiration" prefWidth="120"/>
                <TableColumn fx:id="colActive" text="Actif" prefWidth="80"/>
                <TableColumn fx:id="colUsage" text="Usage" prefWidth="100"/>
            </columns>
        </TableView>

        <!-- Formulaire -->
        <VBox spacing="10" prefWidth="280" styleClass="glass-panel" style="-fx-padding: 15;">
            <Label text="Édition du Code" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
            
            <VBox spacing="5">
                <Label text="Code" styleClass="card-label"/>
                <TextField fx:id="inputCode" promptText="EX: WELCOME10" styleClass="modern-input"/>
            </VBox>
            
            <VBox spacing="5">
                <Label text="Remise (%)" styleClass="card-label"/>
                <TextField fx:id="inputDiscount" promptText="10" styleClass="modern-input"/>
            </VBox>
            
            <VBox spacing="5">
                <Label text="Date d'expiration" styleClass="card-label"/>
                <DatePicker fx:id="inputExpiry" styleClass="modern-input" maxWidth="Infinity"/>
            </VBox>
            
            <VBox spacing="5">
                <Label text="Limite d'usage" styleClass="card-label"/>
                <TextField fx:id="inputUsageLimit" promptText="100" styleClass="modern-input"/>
            </VBox>
            
            <CheckBox fx:id="inputActive" text="Code Actif" styleClass="card-label"/>

            <Region VBox.vgrow="ALWAYS"/>
            
            <HBox spacing="10">
                <Button text="Nouveau" onAction="#onNouveau" styleClass="button-capsule-glass" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="Enregistrer" onAction="#onEnregistrer" styleClass="button-capsule" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
            <Button text="Supprimer" onAction="#onSupprimer" style="-fx-background-color: #ef4444; -fx-text-fill: white;" 
                    styleClass="button-capsule" maxWidth="Infinity"/>
        </VBox>
    </HBox>
</VBox>
