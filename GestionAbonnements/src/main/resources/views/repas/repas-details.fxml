<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<ScrollPane xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestion.ui.repas.RepasDetailsController"
            fitToWidth="true" fitToHeight="true"
            stylesheets="@../../styles/nature-mood.css, @../../styles/card-view.css"
            style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent; -fx-padding: 0;">

    <StackPane style="-fx-background-color: transparent; -fx-padding: 25;">
        <VBox spacing="25" styleClass="glass-panel" prefWidth="600" maxWidth="650" style="-fx-padding: 40;">
            
            <!-- Header Section -->
            <HBox spacing="15" alignment="CENTER_LEFT">
                <StackPane style="-fx-background-color: rgba(34, 197, 94, 0.15); -fx-background-radius: 12; -fx-padding: 10;">
                    <Label text="🍱" style="-fx-font-size: 24;"/>
                </StackPane>
                <VBox spacing="2">
                    <Label text="Ration Intel Report" styleClass="hiker-label" style="-fx-text-fill: #94a3b8; -fx-font-size: 11; -fx-font-weight: 900;"/>
                    <Label fx:id="detailNom" text="Ration Name" style="-fx-font-size: 24; -fx-font-weight: 800; -fx-text-fill: white;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="CLOSE REPORT" onAction="#onFermer" styleClass="button-capsule-glass" style="-fx-padding: 10 25;"/>
            </HBox>

            <Separator style="-fx-opacity: 0.1;"/>

            <!-- Main Info Card -->
            <VBox spacing="20" styleClass="modern-card" style="-fx-padding: 30;">
                <GridPane hgap="20" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints minWidth="120" prefWidth="140" halignment="LEFT"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="📍 Lodge Assignment:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-text-fill: #94a3b8; -fx-font-weight: 700; -fx-font-size: 13;"/>
                    <Label fx:id="detailRestaurant" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-font-weight: 800; -fx-text-fill: white;"/>

                    <Label text="📜 Mission Menu:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-text-fill: #94a3b8; -fx-font-weight: 700; -fx-font-size: 13;"/>
                    <Label fx:id="detailMenu" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-font-weight: 800; -fx-text-fill: white;"/>

                    <Label text="🥘 Category:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-text-fill: #94a3b8; -fx-font-weight: 700; -fx-font-size: 13;"/>
                    <Label fx:id="detailCategorie" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-font-weight: 800; -fx-text-fill: #22c55e;"/>

                    <Label text="🍽️ Serving Type:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-text-fill: #94a3b8; -fx-font-weight: 700; -fx-font-size: 13;"/>
                    <Label fx:id="detailTypePlat" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3" style="-fx-font-weight: 800; -fx-text-fill: white;"/>

                    <Label text="💰 Logistics Cost:" GridPane.columnIndex="0" GridPane.rowIndex="4" style="-fx-text-fill: #94a3b8; -fx-font-weight: 700; -fx-font-size: 13;"/>
                    <Label fx:id="detailPrix" text="-" GridPane.columnIndex="1" GridPane.rowIndex="4" style="-fx-font-weight: 900; -fx-font-size: 18; -fx-text-fill: #F97316;"/>

                    <Label text="⏱️ Prep Intensity:" GridPane.columnIndex="0" GridPane.rowIndex="5" style="-fx-text-fill: #94a3b8; -fx-font-weight: 700; -fx-font-size: 13;"/>
                    <Label fx:id="detailTempsPreparation" text="-" GridPane.columnIndex="1" GridPane.rowIndex="5" style="-fx-font-weight: 800; -fx-text-fill: white;"/>

                    <Label text="📡 Availability:" GridPane.columnIndex="0" GridPane.rowIndex="6" style="-fx-text-fill: #94a3b8; -fx-font-weight: 700; -fx-font-size: 13;"/>
                    <Label fx:id="detailDisponible" text="-" GridPane.columnIndex="1" GridPane.rowIndex="6" style="-fx-font-weight: 800; -fx-text-fill: #22c55e;"/>
                </GridPane>

                <Separator style="-fx-opacity: 0.1;"/>

                <VBox spacing="10">
                    <Label text="Scout Insight / Description" style="-fx-text-fill: #94a3b8; -fx-font-weight: 900; -fx-font-size: 11;"/>
                    <Label fx:id="detailDescription" wrapText="true" style="-fx-font-size: 14; -fx-text-fill: white; -fx-line-spacing: 5;"/>
                </VBox>
                
                <VBox spacing="10" style="-fx-padding: 10 0 0 0;">
                    <Label text="Visual Signal Feed" style="-fx-text-fill: #94a3b8; -fx-font-weight: 900; -fx-font-size: 11;"/>
                    <Label fx:id="detailImageUrl" wrapText="true" style="-fx-font-size: 12; -fx-text-fill: #3b82f6; -fx-font-style: italic;"/>
                </VBox>
            </VBox>

            <!-- Scout Mission Badge -->
            <VBox alignment="CENTER" spacing="10" style="-fx-background-color: rgba(250, 204, 21, 0.05); -fx-padding: 15; -fx-background-radius: 12; -fx-border-color: rgba(250, 204, 21, 0.1);">
                <Label text="EXPLORER VERIFIED" style="-fx-text-fill: #FACC15; -fx-font-weight: 900; -fx-font-size: 11;"/>
                <Label text="Nutritional value scanned and optimized for high-altitude consumption." style="-fx-text-fill: #94a3b8; -fx-font-size: 11; -fx-text-alignment: center;"/>
            </VBox>
        </VBox>
    </StackPane>
</ScrollPane>
