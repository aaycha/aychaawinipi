<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.*?>
<?import java.net.URL?>

<ScrollPane xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestion.ui.repas.RepasListeController"
            fitToWidth="false" fitToHeight="false" styleClass="modern-scroll-pane"
            vbarPolicy="AS_NEEDED" hbarPolicy="AS_NEEDED">
    <stylesheets>
        <URL value="@../../styles/card-view.css" />
        <URL value="@../../styles/nature-mood.css" />
    </stylesheets>

    <VBox spacing="8" styleClass="modern-panel" prefWidth="1100" style="-fx-padding: 10;">
        
        <!-- Nature Header -->
        <HBox spacing="12" alignment="CENTER_LEFT">
            <StackPane style="-fx-background-color: rgba(34, 197, 94, 0.15); -fx-background-radius: 8; -fx-padding: 6;">
                <Label text="🥘" style="-fx-font-size: 16;"/>
            </StackPane>
            <VBox spacing="0">
                <Label text="Trail Recipes &amp; Fuel" styleClass="modern-title" style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: 800;"/>
                <Label text="Manage high-energy meals for the mountain trek" style="-fx-text-fill: #94a3b8; -fx-font-size: 9;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER" spacing="8" style="-fx-background-color: rgba(255,255,255,0.05); -fx-padding: 4 12; -fx-background-radius: 15; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 15;">
                <Circle fill="#22c55e" radius="3"/>
                <Label text="Kitchen Inventory: Healthy" style="-fx-text-fill: white; -fx-font-size: 10; -fx-font-weight: 600;"/>
            </HBox>
        </HBox>

        <!-- Action Bar - Capsule Style -->
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 2 0;">
            <Button text="➕ NEW" onAction="#onNouveauRepas" styleClass="button-capsule" style="-fx-padding: 8 16; -fx-font-size: 11;"/>
            <Button text="🔄 SYNC" onAction="#onActualiser" styleClass="button-capsule-glass" style="-fx-padding: 8 16; -fx-font-size: 11;"/>
            
            <MenuButton text="↑ EXPORT" styleClass="button-capsule-glass" style="-fx-padding: 6 15; -fx-font-size: 11;">
                <items>
                    <MenuItem text="JSON Format" />
                    <MenuItem text="CSV Format" />
                    <MenuItem text="PDF Manifest" onAction="#onExportPDF" />
                </items>
            </MenuButton>
            
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="modern-card" style="-fx-padding: 4 12; -fx-background-radius: 15;">
                <Label text="🔍" style="-fx-font-size: 12;"/>
                <TextField fx:id="searchField" promptText="Scout meals..." styleClass="modern-input" prefWidth="250" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 11;"/>
            </HBox>
        </HBox>

        <!-- Filters Bar -->
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="modern-card" style="-fx-padding: 10 20;">
            <Label text="FILTERS:" style="-fx-text-fill: #94a3b8; -fx-font-weight: 900; -fx-font-size: 10;"/>
            <ComboBox fx:id="filterRestaurantCombo" promptText="Lodges" prefWidth="130" styleClass="modern-input" style="-fx-font-size: 11;"/>
            <ComboBox fx:id="filterMenuCombo" promptText="Menus" prefWidth="110" styleClass="modern-input" style="-fx-font-size: 11;"/>
            <ComboBox fx:id="filterCategorieCombo" promptText="Type" prefWidth="100" styleClass="modern-input" style="-fx-font-size: 11;"/>
            <ComboBox fx:id="filterTypePlatCombo" promptText="Diet" prefWidth="100" styleClass="modern-input" style="-fx-font-size: 11;"/>
            <ComboBox fx:id="filterDisponibleCombo" promptText="Status" prefWidth="100" styleClass="modern-input" style="-fx-font-size: 11;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="countLabel" text="0 rations" style="-fx-text-fill: #22c55e; -fx-font-weight: 800; -fx-font-size: 10; -fx-background-color: rgba(34, 197, 94, 0.1); -fx-padding: 4 10; -fx-background-radius: 10;"/>
            <Button text="RESET" onAction="#onReinitialiserFiltres" styleClass="button-capsule-glass" style="-fx-padding: 6 12; -fx-font-size: 10; -fx-text-fill: #ef4444;"/>
        </HBox>

        <!-- Main Content Split -->
        <GridPane hgap="20" VBox.vgrow="ALWAYS">
            <columnConstraints>
                <ColumnConstraints percentWidth="60"/>
                <ColumnConstraints percentWidth="40"/>
            </columnConstraints>
            
            <!-- Left: Meal List -->
            <VBox GridPane.columnIndex="0" spacing="10">
                <Label text="🍱 Available Rations" styleClass="section-title" style="-fx-font-size: 14; -fx-text-fill: white;"/>
                <ListView fx:id="listView" VBox.vgrow="ALWAYS" minHeight="400" styleClass="modern-list-view" onMouseClicked="#onListClick"/>
            </VBox>
            
            <!-- Right: Scout Preview -->
            <VBox GridPane.columnIndex="1" spacing="15">
                <VBox fx:id="previewSidebar" spacing="15" styleClass="modern-card" style="-fx-padding: 20;">
                    <Label text="RATION PREVIEW" style="-fx-font-weight: 900; -fx-text-fill: #3b82f6; -fx-font-size: 11; -fx-letter-spacing: 1px;"/>
                    
                    <VBox fx:id="previewContainer" alignment="TOP_CENTER" spacing="12">
                        <StackPane fx:id="imageContainer" prefHeight="160" style="-fx-background-color: rgba(255,255,255,0.03); -fx-background-radius: 15; -fx-border-color: rgba(255,255,255,0.05); -fx-border-radius: 15;">
                            <Label text="🍱" style="-fx-font-size: 48; -fx-opacity: 0.1;"/>
                            <ImageView fx:id="previewImage" fitHeight="160" fitWidth="220" preserveRatio="true"/>
                        </StackPane>
                        
                        <VBox spacing="4" alignment="CENTER">
                            <Label fx:id="previewName" text="Select a ration" textAlignment="CENTER" wrapText="true" style="-fx-font-weight: 900; -fx-font-size: 18; -fx-text-fill: white;"/>
                            <Label fx:id="previewCategory" text="Category" style="-fx-text-fill: #22c55e; -fx-font-weight: 800; -fx-background-color: rgba(34, 197, 94, 0.1); -fx-padding: 3 10; -fx-background-radius: 8; -fx-font-size: 10;"/>
                        </VBox>
                        
                        <HBox alignment="CENTER" spacing="30">
                            <VBox alignment="CENTER">
                                <Label text="COST" style="-fx-font-size: 9; -fx-text-fill: #94a3b8; -fx-font-weight: 900;"/>
                                <Label fx:id="previewPrice" text="0.00 €" style="-fx-font-weight: 900; -fx-font-size: 20; -fx-text-fill: #F97316;"/>
                            </VBox>
                            <VBox alignment="CENTER">
                                <Label text="STOCK" style="-fx-font-size: 9; -fx-text-fill: #94a3b8; -fx-font-weight: 900;"/>
                                <Label fx:id="previewStatus" text="-" style="-fx-font-weight: 800; -fx-font-size: 14; -fx-text-fill: white;"/>
                            </VBox>
                        </HBox>
                        
                        <Label fx:id="previewDescription" text="Scout details will appear here..." wrapText="true" style="-fx-text-fill: #94a3b8; -fx-font-size: 11; -fx-line-spacing: 2;" textAlignment="CENTER"/>
                        
                        <HBox spacing="12" alignment="CENTER" style="-fx-padding: 5 0 0 0;">
                            <Button fx:id="btnModifier" text="Edit" onAction="#onModifier" disable="true" styleClass="button-capsule" prefWidth="100" style="-fx-font-size: 11;"/>
                            <Button fx:id="btnSupprimer" text="Drop" onAction="#onSupprimer" disable="true" styleClass="button-capsule-glass" style="-fx-text-fill: #ef4444; -fx-font-size: 11;" prefWidth="100"/>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- AI Nutrition Insight -->
                <VBox spacing="8" styleClass="modern-card" style="-fx-padding: 12; -fx-background-color: rgba(168, 85, 247, 0.05); -fx-border-color: rgba(168, 85, 247, 0.1);">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="✨" style="-fx-font-size: 14;"/>
                        <Label text="Trail Nutrition Insight" style="-fx-font-weight: 900; -fx-text-fill: #a855f7; -fx-font-size: 10;"/>
                    </HBox>
                    <Label text="High-protein rations increase explorer stamina by 15.4%." wrapText="true" style="-fx-text-fill: #94a3b8; -fx-font-size: 10; -fx-font-style: italic;"/>
                </VBox>
            </VBox>
        </GridPane>

        <!-- Footer -->
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 5 0 0 0;">
            <Label fx:id="statusLabel" text="Kitchen Online • LAMMA Explorer Support" style="-fx-text-fill: #64748b; -fx-font-size: 10; -fx-font-weight: 800;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Circle radius="3" fill="#22c55e"/>
                <Label text="Cloud Sync Active" style="-fx-font-size: 10; -fx-text-fill: #94a3b8; -fx-font-weight: 700;"/>
            </HBox>
        </HBox>
    </VBox>
</ScrollPane>
