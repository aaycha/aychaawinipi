<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestion.ui.repas.AdminMenuPlannerController"
            stylesheets="@../../styles/nature-mood.css, @../../styles/restoration-2026.css"
            styleClass="modern-2026-root">
    <top>
        <VBox spacing="10" style="-fx-padding: 15;">
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="Planificateur de Menus Hebdomadaire" style="-fx-font-size: 18px; -fx-font-weight: 900; -fx-text-fill: #1E3A8A;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Button text="Semaine Précédente" styleClass="btn-secondary" style="-fx-background-radius: 15; -fx-font-size: 9px;" onAction="#onPreviousWeek"/>
                    <Label fx:id="currentWeekLabel" text="Semaine du 16 au 22 Février 2026" style="-fx-font-weight: bold; -fx-font-size: 10px;"/>
                    <Button text="Semaine Suivante" styleClass="btn-primary" style="-fx-background-radius: 15; -fx-font-size: 9px;" onAction="#onNextWeek"/>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="false" fitToHeight="false" hbarPolicy="ALWAYS" vbarPolicy="ALWAYS" style="-fx-background-color: transparent;" styleClass="modern-scroll">
            <VBox spacing="8" style="-fx-padding: 10;">
                <GridPane fx:id="plannerGrid" hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="14.28" />
                        <ColumnConstraints percentWidth="14.28" />
                        <ColumnConstraints percentWidth="14.28" />
                        <ColumnConstraints percentWidth="14.28" />
                        <ColumnConstraints percentWidth="14.28" />
                        <ColumnConstraints percentWidth="14.28" />
                        <ColumnConstraints percentWidth="14.28" />
                    </columnConstraints>
                    
                    <!-- Days Headers will be dynamically updated or fixed -->
                </GridPane>
            </VBox>
        </ScrollPane>
    </center>

    <right>
        <VBox fx:id="dishPalette" spacing="10" prefWidth="220" styleClass="admin-sidebar" style="-fx-background-radius: 20 0 0 20; -fx-border-width: 0 0 0 1.5;">
            <padding>
                <Insets top="15" right="10" bottom="15" left="10"/>
            </padding>
            <Label text="CATALOGUE" styleClass="sidebar-title" />
            <HBox spacing="5" alignment="CENTER">
                <Button fx:id="btnShowDishes" text="Plats" onAction="#showDishes" styleClass="btn-toggle-active" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnShowMenus" text="Menus" onAction="#showMenus" styleClass="btn-toggle-inactive" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
            </HBox>
            <TextField fx:id="searchField" promptText="Rechercher..." styleClass="search-bar-smart" />
            <ListView fx:id="availableDishesList" VBox.vgrow="ALWAYS" styleClass="modern-list-view" />
            <Button text="Nouveau Plat" styleClass="btn-turquoise" maxWidth="Infinity" />
        </VBox>
    </right>

</BorderPane>
