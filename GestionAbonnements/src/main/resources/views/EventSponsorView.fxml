<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.*?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestion.controllers.EventSponsorViewController"
            fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="modern-scroll-pane">
    <stylesheets>
        <URL value="@../styles/nature-mood.css" />
        <URL value="@../styles/card-view.css" />
    </stylesheets>
    
    <VBox spacing="15" styleClass="modern-panel" prefWidth="1000" style="-fx-padding: 20;">
        
        <!-- Nature Header -->
        <HBox spacing="15" alignment="CENTER_LEFT">
            <Button text="↩" onAction="#onRetour" styleClass="button-capsule-glass" style="-fx-font-size: 16; -fx-padding: 4 12;"/>
            <StackPane style="-fx-background-color: rgba(59, 130, 246, 0.15); -fx-background-radius: 8; -fx-padding: 8;">
                <Label text="🔗" style="-fx-font-size: 20;"/>
            </StackPane>
            <VBox spacing="2">
                <Label text="Partenariats Événements" styleClass="modern-title" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: 800;"/>
                <Label text="Gérer les associations entre événements et sponsors" style="-fx-text-fill: #94a3b8; -fx-font-size: 11;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER" spacing="10" style="-fx-background-color: rgba(255,255,255,0.05); -fx-padding: 6 15; -fx-background-radius: 20; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 20;">
                <Circle fill="#22c55e" radius="4"/>
                <Label fx:id="statusInfoLabel" text="Connexion Active" style="-fx-text-fill: white; -fx-font-size: 11; -fx-font-weight: 600;"/>
            </HBox>
        </HBox>

        <!-- Action Bar - Capsule Style -->
        <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 5 0;">
            <Button text="➕ NOUVEAU" onAction="#onNouvelle" styleClass="button-capsule" style="-fx-padding: 10 20; -fx-font-size: 12;"/>
            <Button text="🔄 SYNC" onAction="#onActualiser" styleClass="button-capsule-glass" style="-fx-padding: 10 20; -fx-font-size: 12;"/>
            <Button fx:id="btnModifier" text="✏️ EDIT" onAction="#onModifier" disable="true" styleClass="button-capsule-glass" style="-fx-padding: 10 20; -fx-font-size: 12;"/>
            <Button fx:id="btnSupprimer" text="🗑️ PURGE" onAction="#onSupprimer" disable="true" styleClass="button-capsule-glass" style="-fx-padding: 10 20; -fx-text-fill: #ef4444; -fx-font-size: 12;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="📄 PDF" onAction="#onExporterPdf" styleClass="button-capsule-glass" style="-fx-padding: 10 20; -fx-font-size: 12;"/>
            <Button text="📊 STATS" onAction="#onStatistiques" styleClass="button-capsule-glass" style="-fx-padding: 10 20; -fx-font-size: 12;"/>
        </HBox>

        <!-- Filter Grid - Glass -->
        <VBox spacing="12" styleClass="modern-card" style="-fx-padding: 20;">
            <Label text="🔍 Recherche Avancée" styleClass="section-title" style="-fx-font-size: 16; -fx-text-fill: white;"/>
            <GridPane hgap="20" vgap="15">
                <columnConstraints>
                    <ColumnConstraints minWidth="120" prefWidth="150"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints minWidth="120" prefWidth="150"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Niveau Partenariat:" style="-fx-text-fill: #94a3b8; -fx-font-weight: 700; -fx-font-size: 12;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <ComboBox fx:id="filterStatut" prefWidth="400" promptText="Tous les niveaux"
                          styleClass="modern-input" onAction="#onFiltrer" style="-fx-font-size: 12;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Tri Par:" style="-fx-text-fill: #94a3b8; -fx-font-weight: 700; -fx-font-size: 12;" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <ComboBox fx:id="filterType" prefWidth="400" promptText="Défaut"
                          styleClass="modern-input" onAction="#onFiltrer" style="-fx-font-size: 12;" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                <Label text="ID Sponsor:" style="-fx-text-fill: #94a3b8; -fx-font-weight: 700; -fx-font-size: 12;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="filterUserId" promptText="Sponsor..."
                           styleClass="modern-input" onKeyReleased="#onFiltrer" style="-fx-font-size: 12;" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="ID Événement:" style="-fx-text-fill: #94a3b8; -fx-font-weight: 700; -fx-font-size: 12;" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <TextField fx:id="filterEvenementId" promptText="Événement..."
                           styleClass="modern-input" onKeyReleased="#onFiltrer" style="-fx-font-size: 12;" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                <Label text="Recherche Libre:" style="-fx-text-fill: #94a3b8; -fx-font-weight: 700; -fx-font-size: 12;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="searchField" promptText="Entrez un nom d'événement ou de sponsor..."
                           styleClass="modern-input" onKeyReleased="#onRechercher" style="-fx-font-size: 12;" GridPane.columnIndex="1" GridPane.rowIndex="2" GridPane.columnSpan="3"/>
            </GridPane>
        </VBox>

        <!-- Registries List -->
        <VBox spacing="12" VBox.vgrow="ALWAYS">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="📍 Partenariats Actifs" styleClass="section-title" style="-fx-font-size: 16; -fx-text-fill: white;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="countLabel" text="0 associations" style="-fx-text-fill: #3b82f6; -fx-font-weight: 800; -fx-font-size: 11; -fx-background-color: rgba(59, 130, 246, 0.1); -fx-padding: 4 12; -fx-background-radius: 12;"/>
            </HBox>

            <ListView fx:id="listView" VBox.vgrow="ALWAYS" minHeight="400"
                       styleClass="modern-list-view" onMouseClicked="#onListClick">
                <placeholder>
                    <VBox alignment="CENTER" spacing="15" style="-fx-padding: 50;">
                        <Label text="🤝" style="-fx-font-size: 40;"/>
                        <Label text="Aucune association trouvée" style="-fx-text-fill: #94a3b8; -fx-font-size: 16; -fx-font-weight: 600;"/>
                        <Label text="Commencez par créer un nouveau partenariat" style="-fx-text-fill: #64748b; -fx-font-size: 12;"/>
                    </VBox>
                </placeholder>
            </ListView>
        </VBox>
    </VBox>
</ScrollPane>
