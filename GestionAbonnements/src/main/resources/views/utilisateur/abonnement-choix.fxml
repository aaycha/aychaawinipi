<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.shape.Circle?>
<ScrollPane xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestion.ui.utilisateur.AbonnementChoixController"
            fitToWidth="true" fitToHeight="false" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED"
            styleClass="modern-scroll-pane"
            stylesheets="@../../styles/nature-mood.css, @../../styles/card-view.css">

<VBox spacing="20" styleClass="modern-panel">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <!-- Scout Intel Header -->
    <HBox spacing="16" alignment="CENTER_LEFT">
        <StackPane style="-fx-background-color: rgba(249, 115, 22, 0.15); -fx-background-radius: 8; -fx-padding: 8;">
            <Label text="📋" style="-fx-font-size: 20px;"/>
        </StackPane>
        <VBox spacing="0">
            <Label text="Mon Abonnement" styleClass="modern-title" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: 800;"/>
            <Label text="Gérez vos accès et missions actives" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox alignment="CENTER" spacing="8" style="-fx-background-color: rgba(255,255,255,0.05); -fx-padding: 6 15; -fx-background-radius: 20; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 20;">
            <Circle fill="#22c55e" radius="4"/>
            <Label fx:id="statusLabel" text="Prêt" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
    </HBox>

    <!-- Content Area with Tabs -->
    <TabPane fx:id="mainTabPane" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE" styleClass="modern-tab-pane">
        
        <!-- Tab 1: Mes Abonnements -->
        <Tab text="Mes Abonnements">
            <VBox spacing="16" style="-fx-padding: 15 0 0 0;">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Mes abonnements récents" styleClass="section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="🔄 Actualiser" onAction="#onActualiser" styleClass="btn-secondary"/>
                </HBox>
                
                <ListView fx:id="listView" VBox.vgrow="ALWAYS"
                           styleClass="modern-list-view" stylesheets="@../../styles/card-view.css">
                    <placeholder>
                        <VBox alignment="CENTER" spacing="12">
                            <Label text="📭 Aucun abonnement trouvé" styleClass="placeholder-text"/>
                            <Label text="Consultez l'onglet « Offres Disponibles » pour souscrire."
                                   style="-fx-text-fill: #888; -fx-font-size: 11px;"/>
                        </VBox>
                    </placeholder>
                </ListView>
            </VBox>
        </Tab>
        
        <!-- Tab 2: Offres Disponibles -->
        <Tab text="Offres Disponibles">
            <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
                <VBox spacing="20" style="-fx-padding: 20 0 0 0;">
                    <Label text="Nos forfaits 2026" styleClass="section-title"/>
                    
                    <FlowPane fx:id="offersFlowPane" hgap="20" vgap="20" alignment="CENTER">
                        <!-- Dynamic offers will be loaded here -->
                    </FlowPane>
                </VBox>
            </ScrollPane>
        </Tab>
    </TabPane>
</VBox>
</ScrollPane>
