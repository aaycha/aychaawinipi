<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestion.ui.utilisateur.CheckoutController"
      alignment="TOP_CENTER" spacing="0" prefWidth="550"
      style="-fx-background-color: transparent;"
      stylesheets="@../../styles/nature-mood.css, @../../styles/card-view.css">

    <VBox spacing="0" maxWidth="520"
          styleClass="glass-panel" style="-fx-background-radius: 30; -fx-border-radius: 30; -fx-background-color: rgba(15, 23, 42, 0.95);">

        <VBox spacing="20">
            <padding>
                <Insets top="35" right="40" bottom="35" left="40"/>
            </padding>

            <!-- Header -->
            <VBox spacing="10" alignment="CENTER">
                <StackPane style="-fx-background-color: rgba(34, 197, 94, 0.1); -fx-background-radius: 15; -fx-padding: 12;">
                    <Label text="🏔️" style="-fx-font-size: 28;"/>
                </StackPane>
                <Label text="SECURE TRAIL PAY" styleClass="hiker-label" style="-fx-text-fill: #22c55e; -fx-font-weight: 900; -fx-font-size: 12;"/>
                <Label fx:id="amountLabel" text="Total: 0.00 €" style="-fx-font-size: 30; -fx-font-weight: 900; -fx-text-fill: white;"/>
            </VBox>

            <!-- Cart Items Section -->
            <VBox spacing="12" styleClass="modern-card" style="-fx-padding: 20; -fx-background-color: rgba(255,255,255,0.03); -fx-background-radius: 20;">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="🛒" style="-fx-font-size: 16;"/>
                    <Label text="YOUR SELECTION" style="-fx-text-fill: #94a3b8; -fx-font-weight: 900; -fx-font-size: 11;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="cartItemCountLabel" text="0 items" style="-fx-text-fill: #64748b; -fx-font-size: 10;"/>
                </HBox>
                <ScrollPane fitToWidth="true" minHeight="150" maxHeight="300" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                            styleClass="modern-scroll-pane" style="-fx-background: transparent; -fx-background-color: transparent;">
                    <VBox fx:id="cartItemsList" spacing="12" style="-fx-padding: 5;"/>
                </ScrollPane>

                <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 8 0 0 0;">
                    <TextField fx:id="promoCodeField" promptText="Promo Code" styleClass="modern-input" HBox.hgrow="ALWAYS" style="-fx-font-size: 11;"/>
                    <Button text="APPLY" onAction="#onApplyPromo" styleClass="button-capsule-glass" style="-fx-padding: 8 15; -fx-font-size: 10;"/>
                </HBox>
                <Label fx:id="promoMsgLabel" text="" style="-fx-font-size: 10; -fx-text-fill: #f97316;"/>
            </VBox>

            <!-- Footer -->
            <VBox spacing="12">
                <HBox spacing="10" alignment="CENTER" style="-fx-background-color: rgba(34, 197, 94, 0.05); -fx-padding: 12; -fx-background-radius: 12; -fx-border-color: rgba(34, 197, 94, 0.1);">
                    <Label text="🔒" style="-fx-font-size: 16;"/>
                    <Label text="EXPEDITION FUNDS ENCRYPTED" style="-fx-font-weight: 900; -fx-font-size: 10; -fx-text-fill: #22c55e;"/>
                </HBox>

                <Button fx:id="payButton" text="PAYER &amp; VALIDER LA MISSION" onAction="#onPay"
                        styleClass="button-capsule" maxWidth="Infinity" style="-fx-padding: 18; -fx-font-size: 14;"/>

                <Button text="ABORT MISSION" onAction="#onCancel" maxWidth="Infinity"
                        style="-fx-text-fill: #64748b; -fx-background-color: transparent; -fx-cursor: hand; -fx-font-weight: 800; -fx-font-size: 11;"/>
            </VBox>
        </VBox>
    </VBox>
</VBox>

