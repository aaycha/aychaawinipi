<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import java.net.URL?>

<ScrollPane xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestion.ui.utilisateur.EspaceUtilisateurController"
            fitToWidth="true" styleClass="modern-scroll-pane"
            stylesheets="@../../styles/nature-mood.css, @../../styles/card-view.css"
            style="-fx-background: transparent; -fx-background-color: transparent;">

    <VBox spacing="10" prefWidth="1100" style="-fx-padding: 15; -fx-background-color: transparent;">
        
        <!-- Hiker Header -->
        <HBox spacing="12" alignment="CENTER_LEFT">
            <VBox spacing="0" HBox.hgrow="ALWAYS">
                <Label text="MY BASE CAMP" styleClass="text-hero" style="-fx-font-size: 20;"/>
                <Label text="Log your mountain mission data and check trail status" styleClass="text-muted" style="-fx-font-size: 10;"/>
            </VBox>
        </HBox>

        <!-- Quick Navigation -->
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="glass-panel" style="-fx-padding: 8 15; -fx-background-radius: 12;">
            <Button text="🏠 BASE CAMP PORTAL" onAction="#onRetourAccueil" styleClass="button-capsule" style="-fx-padding: 6 15; -fx-background-radius: 8; -fx-font-size: 11;"/>
            <Separator orientation="VERTICAL" prefHeight="12" style="-fx-opacity: 0.1;"/>
            <Label fx:id="sectionLabel" text="Mission Terminal: System Ready" styleClass="stat-title" style="-fx-font-size: 10;"/>
        </HBox>

        <!-- Dynamic Content Nodes -->
        <FlowPane fx:id="cardsContainer" hgap="12" vgap="12" prefWrapLength="950" alignment="TOP_LEFT"/>
        
        <!-- Bottom Insight -->
        <VBox spacing="8" styleClass="glass-panel" style="-fx-padding: 12; -fx-background-color: rgba(16, 185, 129, 0.05); -fx-border-color: rgba(16, 185, 129, 0.1);">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="🍃" style="-fx-font-size: 14;"/>
                <Label text="SCOUT WISDOM" styleClass="stat-title" style="-fx-text-fill: -fx-nature-accent-green; -fx-font-size: 10;"/>
            </HBox>
            <Label text="Your mission efficiency is optimized. The LAMA Navigator ensures all trail conditions are monitored for your safety." 
                   wrapText="true" styleClass="text-muted" style="-fx-font-style: italic; -fx-font-size: 10;"/>
        </VBox>
    </VBox>
</ScrollPane>
