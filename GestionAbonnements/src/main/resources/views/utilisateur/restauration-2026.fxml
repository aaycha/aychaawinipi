<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<ScrollPane xmlns="http://javafx.com/javafx/11"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestion.ui.utilisateur.Restauration2026Controller"
            fitToWidth="false" fitToHeight="false" styleClass="modern-scroll-pane"
            hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED"
            stylesheets="@../../styles/nature-mood.css, @../../styles/card-view.css"
            style="-fx-background: transparent; -fx-background-color: #0A0F0D;">

    <AnchorPane prefWidth="1050" prefHeight="650" style="-fx-background-color: transparent;">
    <!-- Nature Background Gradient -->
    <StackPane AnchorPane.topAnchor="0"
               AnchorPane.bottomAnchor="0"
               AnchorPane.leftAnchor="0"
               AnchorPane.rightAnchor="0"
               style="-fx-background-color: linear-gradient(to bottom right, #0A0F0D, #1E3932);"/>

    <VBox spacing="6"
          AnchorPane.topAnchor="8"
          AnchorPane.leftAnchor="10"
          AnchorPane.rightAnchor="10"
          AnchorPane.bottomAnchor="8">

        <!-- Trail Navbar -->
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="glass-panel" style="-fx-padding: 6 15; -fx-background-radius: 10;">
            <Label text="🏔️ LAMMA EXPEDITION" style="-fx-font-size: 14; -fx-font-weight: 900; -fx-text-fill: white; -fx-letter-spacing: 1;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Scout Search -->
            <HBox spacing="6" alignment="CENTER_LEFT" styleClass="modern-input" style="-fx-padding: 4 10; -fx-background-radius: 8; -fx-min-width: 200;">
                <Label text="🔍" style="-fx-font-size: 10;"/>
                <TextField promptText="Scout for trail rations..." style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 11;" HBox.hgrow="ALWAYS"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <StackPane style="-fx-background-color: rgba(34, 197, 94, 0.1); -fx-background-radius: 50; -fx-padding: 4;">
                    <Label text="👤" style="-fx-font-size: 14;"/>
                </StackPane>
                <Label text="Scout Emma" style="-fx-text-fill: white; -fx-font-weight: 700; -fx-font-size: 11;"/>
            </HBox>
        </HBox>

        <!-- Main Trail Grid -->
        <HBox spacing="20" VBox.vgrow="ALWAYS">

            <!-- Left: Rations Feed -->
            <VBox spacing="8" prefWidth="400">
                <VBox spacing="0">
                    <Label text="NUTRITIONAL INTEL" styleClass="hiker-label" style="-fx-text-fill: #22c55e; -fx-font-weight: 900; -fx-font-size: 8;"/>
                    <Label text="Discover Your Perfect Ration" style="-fx-font-size: 18; -fx-font-weight: 800; -fx-text-fill: white; -fx-letter-spacing: -0.5;"/>
                </VBox>

                <!-- Trail Tags -->
                <HBox spacing="6">
                    <Button text="🔥 ALL GEAR" styleClass="button-capsule" style="-fx-padding: 4 12; -fx-font-size: 11;"/>
                    <Button text="🍔 HIGH-ALT" styleClass="button-capsule-glass" style="-fx-padding: 4 12; -fx-font-size: 11;"/>
                    <Button text="🥗 FORAGER" styleClass="button-capsule-glass" style="-fx-padding: 4 12; -fx-font-size: 11;"/>
                </HBox>

                <!-- Ration Scroll Feed -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" hbarPolicy="NEVER" styleClass="modern-scroll-pane">
                    <VBox fx:id="dishListContainer" spacing="12" style="-fx-padding: 5 10 10 2;">
                        <!-- Dynamic items -->
                    </VBox>
                </ScrollPane>
            </VBox>

            <!-- Right: Detailed Ration Insight -->
            <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="glass-panel" alignment="TOP_CENTER" style="-fx-padding: 15; -fx-background-radius: 12;">
                
                <StackPane style="-fx-background-color: rgba(255,255,255,0.03); -fx-background-radius: 12; -fx-padding: 6; -fx-border-color: rgba(255,255,255,0.05); -fx-border-radius: 12;">
                    <ImageView fx:id="featuredImage" fitWidth="280" preserveRatio="true" style="-fx-effect: dropshadow(gaussian, rgba(34, 197, 94, 0.2), 12, 0, 0, 5);"/>
                </StackPane>

                <VBox spacing="10">
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="0" HBox.hgrow="ALWAYS">
                            <Label text="FEATURED MISSION DEPLOYMENT" styleClass="hiker-label" style="-fx-text-fill: #94a3b8; -fx-font-weight: 900; -fx-font-size: 8;"/>
                            <Label fx:id="featuredTitle" text="Ration Name" style="-fx-font-size: 18; -fx-font-weight: 900; -fx-text-fill: white;"/>
                        </VBox>
                        <Label fx:id="featuredTime" text="⏱ 20 min" style="-fx-text-fill: #94a3b8; -fx-font-weight: 700; -fx-font-size: 11;"/>
                    </HBox>

                    <Label fx:id="featuredMarketingText" wrapText="true" text="Expedition-grade ingredients optimized for peak performance." 
                           style="-fx-font-size: 11; -fx-text-fill: #cbd5e1; -fx-line-spacing: 1.5;"/>

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label fx:id="featuredPrice" text="24.00 €" style="-fx-font-size: 20; -fx-font-weight: 900; -fx-text-fill: #F97316;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <HBox alignment="CENTER" spacing="6" style="-fx-background-color: rgba(249, 115, 22, 0.1); -fx-padding: 4 12; -fx-background-radius: 10; -fx-border-color: rgba(249, 115, 22, 0.2);">
                             <Label text="🔥 420 kcal" style="-fx-text-fill: #F97316; -fx-font-weight: 900; -fx-font-size: 10;"/>
                        </HBox>
                    </HBox>

                    <Separator style="-fx-opacity: 0.1;"/>

                    <HBox spacing="10" alignment="CENTER">
                        <Button text="✨ MOD GEAR" onAction="#onPersonalize" styleClass="button-capsule-glass" prefHeight="35" prefWidth="120" style="-fx-font-size: 11;"/>
                        <Button text="🛒 COMMIT TO KIT" onAction="#onAddToCart" styleClass="button-capsule" prefHeight="35" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-font-size: 11;"/>
                    </HBox>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <!-- Global Scout Controller -->
                <HBox spacing="25" alignment="CENTER" styleClass="modern-card" style="-fx-padding: 6 25; -fx-background-radius: 20; -fx-background-color: rgba(15, 23, 42, 0.6); -fx-border-color: rgba(255,255,255,0.05);">
                    <Label text="🏠" style="-fx-font-size: 16; -fx-cursor: hand;" onMouseClicked="#onHome"/>
                    <StackPane onMouseClicked="#onOpenCheckout" style="-fx-cursor: hand;">
                        <Label text="🛒" style="-fx-font-size: 16;"/>
                        <Label fx:id="cartCountBadge" text="0" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-size: 7; -fx-font-weight: 900; -fx-padding: 1 3; -fx-background-radius: 5;" StackPane.alignment="TOP_RIGHT">
                            <StackPane.margin><Insets top="-3" right="-3"/></StackPane.margin>
                        </Label>
                    </StackPane>
                    <Label text="❤️" style="-fx-font-size: 16; -fx-cursor: hand;" onMouseClicked="#toggleFavorites"/>
                    <Label text="👤" style="-fx-font-size: 16; -fx-cursor: hand;" onMouseClicked="#onProfile"/>
                </HBox>
            </VBox>
        </HBox>
    </VBox>
    </AnchorPane>
</ScrollPane>
