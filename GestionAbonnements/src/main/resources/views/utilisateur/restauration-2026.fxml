<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestion.ui.utilisateur.Restauration2026Controller"
            fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            style="-fx-background: transparent; -fx-background-color: transparent;"
            stylesheets="@../../styles/nature-mood.css, @../../styles/card-view.css">

    <VBox spacing="4" style="-fx-background-color: linear-gradient(to bottom right, #0A0F0D, #1E3932); -fx-padding: 4 5;">

        <!-- Trail Navbar -->
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="glass-panel" style="-fx-padding: 8 15; -fx-background-radius: 10;">
            <Label text="🏔️ LAMMA EXPEDITION" style="-fx-font-size: 14; -fx-font-weight: 900; -fx-text-fill: white; -fx-letter-spacing: 1;"/>
            <Region HBox.hgrow="ALWAYS"/>

            <!-- Scout Search -->
            <HBox spacing="6" alignment="CENTER_LEFT" styleClass="modern-input" style="-fx-padding: 4 10; -fx-background-radius: 8; -fx-min-width: 200;">
                <Label text="🔍" style="-fx-font-size: 10;"/>
                <TextField promptText="Scout for trail rations..." style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 11;" HBox.hgrow="ALWAYS"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox spacing="15" alignment="CENTER_LEFT">
                <StackPane onMouseClicked="#onOpenCheckout" style="-fx-cursor: hand; -fx-background-color: rgba(255, 255, 255, 0.05); -fx-background-radius: 50; -fx-padding: 8;">
                    <Label text="🛒" style="-fx-font-size: 16;"/>
                    <Label fx:id="cartCountBadge" text="0" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-size: 8; -fx-font-weight: 900; -fx-padding: 1 4; -fx-background-radius: 6;" StackPane.alignment="TOP_RIGHT">
                        <StackPane.margin><Insets top="-4" right="-4"/></StackPane.margin>
                    </Label>
                </StackPane>
                
                <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-cursor: hand;" onMouseClicked="#onProfile">
                    <StackPane style="-fx-background-color: rgba(34, 197, 94, 0.1); -fx-background-radius: 50; -fx-padding: 4;">
                        <Label text="👤" style="-fx-font-size: 14;"/>
                    </StackPane>
                    <Label text="Scout" style="-fx-text-fill: white; -fx-font-weight: 700; -fx-font-size: 11;"/>
                </HBox>
            </HBox>
        </HBox>

        <!-- Main Trail Grid -->
        <HBox spacing="20" VBox.vgrow="ALWAYS">

            <!-- Left: Rations Feed -->
            <VBox spacing="8" prefWidth="420" minWidth="350">
                <VBox spacing="2">
                    <Label text="NUTRITIONAL INTEL" styleClass="hiker-label" style="-fx-text-fill: #22c55e; -fx-font-weight: 900; -fx-font-size: 9;"/>
                    <Label text="Trail Rations" style="-fx-font-size: 18; -fx-font-weight: 800; -fx-text-fill: white; -fx-letter-spacing: -0.3;"/>
                </VBox>

                <!-- Trail Tags -->
                <HBox spacing="6">
                    <Button text="🔥 ALL GEAR" onAction="#applyFilters" styleClass="button-capsule" style="-fx-padding: 5 14; -fx-font-size: 11;"/>
                    <Button text="❤️ MY SAVED" onAction="#toggleFavorites" styleClass="button-capsule-glass" style="-fx-padding: 5 14; -fx-font-size: 11; -fx-text-fill: #ef4444;"/>
                    <Button text="🍔 HIGH-ALT" styleClass="button-capsule-glass" style="-fx-padding: 5 14; -fx-font-size: 11;"/>
                    <Button text="🥗 FORAGER" styleClass="button-capsule-glass" style="-fx-padding: 5 14; -fx-font-size: 11;"/>
                </HBox>

                <!-- Ration Scroll Feed -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                            styleClass="modern-scroll-pane"
                            style="-fx-background: transparent; -fx-background-color: transparent; -fx-min-height: 300;">
                    <VBox fx:id="dishListContainer" spacing="8" style="-fx-padding: 4 8 8 0;">
                        <!-- Dynamic items loaded by controller -->
                    </VBox>
                </ScrollPane>
            </VBox>

            <!-- Right: Detailed Ration Insight -->
            <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                        HBox.hgrow="ALWAYS" style="-fx-background: transparent; -fx-background-color: transparent;">
                <VBox spacing="12" styleClass="glass-panel" alignment="TOP_CENTER"
                      style="-fx-padding: 18; -fx-background-radius: 14;">

                    <!-- Featured Image -->
                    <StackPane style="-fx-background-color: rgba(255,255,255,0.03); -fx-background-radius: 14; -fx-padding: 8; -fx-border-color: rgba(255,255,255,0.05); -fx-border-radius: 14;">
                        <ImageView fx:id="featuredImage" fitWidth="300" preserveRatio="true" style="-fx-effect: dropshadow(gaussian, rgba(34, 197, 94, 0.2), 12, 0, 0, 5);"/>
                    </StackPane>

                    <!-- Details -->
                    <VBox spacing="10">
                        <HBox alignment="CENTER_LEFT">
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label text="FEATURED MISSION DEPLOYMENT" styleClass="hiker-label" style="-fx-text-fill: #94a3b8; -fx-font-weight: 900; -fx-font-size: 9;"/>
                                <Label fx:id="featuredTitle" text="Ration Name" style="-fx-font-size: 20; -fx-font-weight: 900; -fx-text-fill: white;"/>
                            </VBox>
                            <Label fx:id="featuredTime" text="⏱ 20 min" style="-fx-text-fill: #94a3b8; -fx-font-weight: 700; -fx-font-size: 12;"/>
                        </HBox>

                        <Label fx:id="featuredMarketingText" wrapText="true"
                               text="Expedition-grade ingredients optimized for peak performance."
                               style="-fx-font-size: 12; -fx-text-fill: #cbd5e1; -fx-line-spacing: 1.5;"/>

                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label fx:id="featuredPrice" text="24.00 €" style="-fx-font-size: 22; -fx-font-weight: 900; -fx-text-fill: #F97316;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <HBox alignment="CENTER" spacing="6" style="-fx-background-color: rgba(249, 115, 22, 0.1); -fx-padding: 6 14; -fx-background-radius: 12; -fx-border-color: rgba(249, 115, 22, 0.2);">
                                <Label text="🔥 420 kcal" style="-fx-text-fill: #F97316; -fx-font-weight: 900; -fx-font-size: 11;"/>
                            </HBox>
                        </HBox>

                        <Separator style="-fx-opacity: 0.1;"/>

                        <!-- Action Buttons -->
                        <HBox spacing="12" alignment="CENTER">
                            <Button text="✨ MOD GEAR" onAction="#onPersonalize" styleClass="button-capsule-glass" prefHeight="38" prefWidth="130" style="-fx-font-size: 12;"/>
                            <Button text="🛒 COMMIT TO KIT" onAction="#onAddToCart" styleClass="button-capsule" prefHeight="38" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-font-size: 12;"/>
                        </HBox>
                    </VBox>

                    <Region VBox.vgrow="ALWAYS"/>

                    <!-- Footer spacer -->
                    <Region prefHeight="20"/>
                </VBox>
            </ScrollPane>
        </HBox>
    </VBox>
</ScrollPane>
