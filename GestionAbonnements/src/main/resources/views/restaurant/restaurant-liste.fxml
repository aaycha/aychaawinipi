<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.*?>
<?import java.net.URL?>

<ScrollPane xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestion.ui.restaurant.RestaurantListeController"
            fitToWidth="true" fitToHeight="false" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED"
            style="-fx-background: transparent; -fx-background-color: transparent;"
            stylesheets="@../../styles/card-view.css, @../../styles/nature-mood.css">
    
    <VBox spacing="4" styleClass="modern-panel" prefWidth="1000" style="-fx-padding: 8;">
        
        <!-- Nature Header -->
        <HBox spacing="12" alignment="CENTER_LEFT">
            <StackPane style="-fx-background-color: rgba(249, 115, 22, 0.15); -fx-background-radius: 8; -fx-padding: 6;">
                <Label text="🍴" style="-fx-font-size: 16;"/>
            </StackPane>
            <VBox spacing="0">
                <Label text="Base Camp Dining" styleClass="modern-title" style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: 800;"/>
                <Label text="Manage mountain resorts and trail-side fuel stations" style="-fx-text-fill: #94a3b8; -fx-font-size: 9;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER" spacing="8" style="-fx-background-color: rgba(255,255,255,0.05); -fx-padding: 4 12; -fx-background-radius: 15; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 15;">
                <Circle fill="#F97316" radius="3"/>
                <Label fx:id="statusLabel" text="Kitchen Online" style="-fx-text-fill: white; -fx-font-size: 10; -fx-font-weight: 600;"/>
            </HBox>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 2 0;">
            <Button fx:id="btnNouveau" text="➕ NEW" onAction="#onNouveauRestaurant" styleClass="button-capsule" style="-fx-padding: 8 16; -fx-font-size: 11;"/>
            <Button fx:id="btnActualiser" text="🔄 SYNC" onAction="#onActualiser" styleClass="button-capsule-glass" style="-fx-padding: 8 16; -fx-font-size: 11;"/>
            <Button fx:id="btnModifier" text="✏️ EDIT" onAction="#onModifier" disable="true" styleClass="button-capsule-glass" style="-fx-padding: 8 16; -fx-font-size: 11;"/>
            <Button fx:id="btnSupprimer" text="🗑️ REMOVE" onAction="#onSupprimer" disable="true" styleClass="button-capsule-glass" style="-fx-padding: 8 16; -fx-text-fill: #ef4444; -fx-font-size: 11;"/>
            <Button fx:id="btnVoirDetails" text="👁️ DETAILS" onAction="#onVoirDetails" disable="true" styleClass="button-capsule-glass" style="-fx-padding: 8 16; -fx-text-fill: #3b82f6; -fx-font-size: 11;"/>
            <Button fx:id="btnReserver" text="📅 RÉSERVER" onAction="#onReserver" visible="false" managed="false" styleClass="button-capsule" style="-fx-padding: 8 16; -fx-font-size: 11; -fx-background-color: #00D4B4;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="searchField" promptText="🔍 Scout search..." styleClass="modern-input" prefWidth="220" style="-fx-font-size: 11;"/>
        </HBox>

        <!-- Filter Grid - Glass -->
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="modern-card" style="-fx-padding: 6 15;">
            <Label text="Status:" style="-fx-text-fill: #94a3b8; -fx-font-weight: 700; -fx-font-size: 11;"/>
            <ComboBox fx:id="filterActifCombo" promptText="All Lodges" styleClass="modern-input" prefWidth="150" style="-fx-font-size: 11;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="countLabel" text="0 lodges located" style="-fx-text-fill: #F97316; -fx-font-weight: 800; -fx-font-size: 11; -fx-background-color: rgba(249, 115, 22, 0.1); -fx-padding: 4 12; -fx-background-radius: 12;"/>
            <Button text="❌ RESET" onAction="#onReinitialiserFiltres" styleClass="button-capsule-glass" style="-fx-padding: 6 15; -fx-font-size: 10;"/>
        </HBox>

        <!-- Restaurants List -->
        <VBox spacing="10" VBox.vgrow="ALWAYS">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="📋 Registered Lodges" styleClass="section-title" style="-fx-font-size: 14; -fx-text-fill: white;"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

            <ListView fx:id="listView" VBox.vgrow="ALWAYS" minHeight="300"
                       styleClass="modern-list-view" onMouseClicked="#onListClick">
                <placeholder>
                    <VBox alignment="CENTER" spacing="10" style="-fx-padding: 40;">
                        <Label text="🏘️" style="-fx-font-size: 32;"/>
                        <Label text="No dining spots on the map" style="-fx-text-fill: #94a3b8; -fx-font-size: 14; -fx-font-weight: 600;"/>
                        <Label text="Expand your camp network by adding a new restaurant" style="-fx-text-fill: #64748b; -fx-font-size: 11;"/>
                    </VBox>
                </placeholder>
            </ListView>
        </VBox>
    </VBox>
</ScrollPane>
