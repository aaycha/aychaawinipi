<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestion.controllers.EquipementListeController"
            fitToWidth="true" fitToHeight="true" styleClass="modern-scroll-pane"
            vbarPolicy="AS_NEEDED" hbarPolicy="AS_NEEDED"
            stylesheets="@/styles/modern-module.css, @/styles/card-view.css, @/styles/nature-mood.css">

    <VBox spacing="8" styleClass="modern-panel" prefWidth="1000" style="-fx-padding: 12;">
        
        <HBox spacing="12" alignment="CENTER_LEFT">
            <StackPane style="-fx-background-color: rgba(249, 115, 22, 0.15); -fx-background-radius: 8; -fx-padding: 6;">
                <Label text="📊" style="-fx-font-size: 16;"/>
            </StackPane>
            <VBox spacing="0">
                <Label text="Dashboard Administrateur" styleClass="modern-title" style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: 800;"/>
                <Label text="Vue globale sur équipements, groupes et messages" style="-fx-text-fill: #94a3b8; -fx-font-size: 9;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER" spacing="8" style="-fx-background-color: rgba(255,255,255,0.05); -fx-padding: 4 12; -fx-background-radius: 15;">
                <Circle fill="#22c55e" radius="3"/>
                <Label fx:id="statusLabel" text="Inventaire actif" style="-fx-text-fill: white; -fx-font-size: 10; -fx-font-weight: 600;"/>
            </HBox>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 2 0;">
            <Button text="➕ NEW" onAction="#onNouveau" styleClass="button-capsule" style="-fx-padding: 8 16; -fx-font-size: 11;"/>
            <Button text="🔄 SYNC" onAction="#onActualiser" styleClass="button-capsule-glass" style="-fx-padding: 8 16; -fx-font-size: 11;"/>
            <Button fx:id="btnModifier" text="✏️ EDIT" onAction="#onModifier" disable="true" styleClass="button-capsule-glass" style="-fx-padding: 8 16; -fx-font-size: 11;"/>
            <Button fx:id="btnSupprimer" text="🗑️ REMOVE" onAction="#onSupprimer" disable="true" styleClass="button-capsule-glass" style="-fx-padding: 8 16; -fx-text-fill: #ef4444; -fx-font-size: 11;"/>
            <Button fx:id="btnDetails" text="👁️ DETAILS" onAction="#onVoirDetails" disable="true" styleClass="button-capsule-glass" style="-fx-padding: 8 16; -fx-text-fill: #3b82f6; -fx-font-size: 11;"/>
            <Button text="📧 Email" onAction="#onEnvoyerEmail" styleClass="button-capsule-glass" style="-fx-padding: 8 16; -fx-font-size: 11;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="searchField" promptText="🔍 Rechercher..." styleClass="modern-input" prefWidth="220" style="-fx-font-size: 11;"/>
        </HBox>

        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="modern-card" style="-fx-padding: 10 20;">
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="countLabel" text="0 équipement(s)" style="-fx-text-fill: #F97316; -fx-font-weight: 800; -fx-font-size: 11; -fx-background-color: rgba(249, 115, 22, 0.1); -fx-padding: 4 12; -fx-background-radius: 12;"/>
            <Button text="❌ RESET" onAction="#onReinitialiser" styleClass="button-capsule-glass" style="-fx-padding: 6 15; -fx-font-size: 10;"/>
        </HBox>

        <HBox spacing="16" VBox.vgrow="ALWAYS">
            <!-- Colonne Équipements -->
            <VBox spacing="10" VBox.vgrow="ALWAYS">
                <VBox spacing="8" styleClass="modern-card" VBox.vgrow="ALWAYS" style="-fx-padding: 10 12;">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="📋 Équipements" styleClass="section-title" style="-fx-font-size: 14; -fx-text-fill: white;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <ListView fx:id="listView" VBox.vgrow="ALWAYS" minHeight="260"
                               styleClass="modern-list-view" onMouseClicked="#onListClick">
                        <placeholder>
                            <VBox alignment="CENTER" spacing="10" style="-fx-padding: 40;">
                                <Label text="⛺" style="-fx-font-size: 32;"/>
                                <Label text="Aucun équipement" style="-fx-text-fill: #94a3b8; -fx-font-size: 14; -fx-font-weight: 600;"/>
                                <Label text="Ajoutez une tente, matelas, lunettes..." style="-fx-text-fill: #64748b; -fx-font-size: 11;"/>
                            </VBox>
                        </placeholder>
                    </ListView>
                </VBox>
            </VBox>

            <!-- Colonne Groupes & Messages + Stats -->
            <VBox spacing="10" prefWidth="380">
                <!-- Carte Groupes -->
                <VBox spacing="6" styleClass="modern-card" style="-fx-padding: 8 10;">
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="👥 Groupes" styleClass="section-title" style="-fx-font-size: 13; -fx-text-fill: white;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <ListView fx:id="groupsAdminList" prefHeight="120" styleClass="modern-list-view"/>
                </VBox>

                <!-- Carte Derniers messages -->
                <VBox spacing="6" styleClass="modern-card" style="-fx-padding: 8 10;">
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="💬 Derniers messages" styleClass="section-title" style="-fx-font-size: 13; -fx-text-fill: white;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <ListView fx:id="messagesAdminList" prefHeight="120" styleClass="modern-list-view"/>
                </VBox>

                <!-- Carte Statistiques -->
                <VBox spacing="8" styleClass="modern-card" style="-fx-padding: 8 10;">
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="📈 Statistiques rapides" styleClass="section-title" style="-fx-font-size: 12; -fx-text-fill: white;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <HBox spacing="12" alignment="CENTER">
                        <VBox spacing="4" alignment="CENTER">
                            <Label text="Groupe le plus actif" style="-fx-text-fill: #e5e7eb; -fx-font-size: 10;"/>
                            <StackPane fx:id="chartGroupActif" prefWidth="140" prefHeight="140"
                                       style="-fx-background-color: rgba(15,23,42,0.85); -fx-background-radius: 70;"/>
                        </VBox>
                        <VBox spacing="4" alignment="CENTER">
                            <Label text="Équipement le plus vu" style="-fx-text-fill: #e5e7eb; -fx-font-size: 10;"/>
                            <StackPane fx:id="chartEquipementVu" prefWidth="140" prefHeight="140"
                                       style="-fx-background-color: rgba(15,23,42,0.85); -fx-background-radius: 70;"/>
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>
        </HBox>

    </VBox>
</ScrollPane>
