<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestion.controllers.EquipementStoreController"
            fitToWidth="true" fitToHeight="true" styleClass="modern-scroll-pane"
            stylesheets="@/styles/modern-module.css, @/styles/card-view.css, @/styles/nature-mood.css">

    <VBox spacing="8" styleClass="modern-panel" prefWidth="1000" style="-fx-padding: 12;">
        
        <HBox spacing="12" alignment="CENTER_LEFT">
            <StackPane style="-fx-background-color: rgba(249, 115, 22, 0.15); -fx-background-radius: 8; -fx-padding: 6;">
                <Label text="🛒" style="-fx-font-size: 16;"/>
            </StackPane>
            <VBox spacing="0">
                <Label text="Boutique Équipements Camping" styleClass="modern-title" style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: 800;"/>
                <Label text="Tentes, matelas, lunettes, sacs de couchage - tout pour le camping" style="-fx-text-fill: #94a3b8; -fx-font-size: 9;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <!-- Zone météo (API Open-Meteo) -->
            <HBox alignment="CENTER" spacing="4"
                  style="-fx-background-color: rgba(15,23,42,0.9); -fx-padding: 4 10; -fx-background-radius: 14;">
                <Label text="🌤" style="-fx-font-size: 12;"/>
                <Label fx:id="weatherLabel"
                       text="Météo: chargement..."
                       style="-fx-text-fill: #e5e7eb; -fx-font-size: 10; -fx-font-weight: 600;"/>
            </HBox>
            <HBox alignment="CENTER" spacing="8" style="-fx-background-color: rgba(255,255,255,0.05); -fx-padding: 4 12; -fx-background-radius: 15;">
                <Circle fill="#22c55e" radius="3"/>
                <Label text="En stock" style="-fx-text-fill: white; -fx-font-size: 10; -fx-font-weight: 600;"/>
            </HBox>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 2 0;">
            <Button fx:id="btnAjouter"
                    text="+ Ajouter"
                    onAction="#onAjouter"
                    styleClass="button-capsule"
                    style="-fx-font-size: 11;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="searchField" promptText="🔍 Rechercher un équipement..." styleClass="modern-input" prefWidth="280" style="-fx-font-size: 11;"/>
            <ComboBox fx:id="filterCategorie" promptText="Catégorie" styleClass="modern-input" prefWidth="160" style="-fx-font-size: 11;"/>
            <Label fx:id="countLabel" text="0 équipement(s)" style="-fx-text-fill: #F97316; -fx-font-weight: 800; -fx-font-size: 11; -fx-background-color: rgba(249, 115, 22, 0.1); -fx-padding: 4 12; -fx-background-radius: 12;"/>
        </HBox>

        <FlowPane fx:id="cardsPane" hgap="15" vgap="15" style="-fx-padding: 10 0;">
            <VBox.margin>
                <Insets top="10" right="0" bottom="0" left="0"/>
            </VBox.margin>
        </FlowPane>

    </VBox>
</ScrollPane>
