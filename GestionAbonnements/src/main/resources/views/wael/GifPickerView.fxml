<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestion.controllers.GifPickerController"
            prefWidth="500" prefHeight="600">

    <!-- Search Bar -->
    <top>
        <HBox spacing="10" style="-fx-padding: 15; -fx-background-color: #1a2540; -fx-border-color: rgba(255,255,255,0.08); -fx-border-width: 0 0 1 0;">
            <TextField fx:id="searchField" promptText="Chercher un GIF..." style="-fx-background-color: rgba(255,255,255,0.08); -fx-text-fill: #ffffff; -fx-padding: 8; -fx-background-radius: 8;" HBox.hgrow="ALWAYS"/>
            <Button text="Chercher" style="-fx-padding: 8 16; -fx-background-color: #25d366; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" onAction="#onSearch"/>
        </HBox>
    </top>

    <!-- GIFs Grid -->
    <center>
        <ScrollPane style="-fx-background-color: #0f172a;">
            <FlowPane fx:id="gifsContainer" hgap="10" vgap="10" style="-fx-padding: 15; -fx-background-color: #0f172a;"/>
        </ScrollPane>
    </center>

    <!-- Status Label -->
    <bottom>
        <Label fx:id="statusLabel" text="Prêt à chercher des GIFs..." style="-fx-text-fill: #cbd5e1; -fx-padding: 10; -fx-background-color: #1a2540; -fx-border-color: rgba(255,255,255,0.08); -fx-border-width: 1 0 0 0;"/>
    </bottom>
</BorderPane>

