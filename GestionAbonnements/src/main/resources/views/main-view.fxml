<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="1554.0" prefWidth="3799.0" styleClass="nature-root" stylesheets="@../styles/nature-mood.css, @../styles/dashboard-premium.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gestion.controllers.MainController">

    <top>
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 20 40;" styleClass="top-bar">
                <ImageView fitHeight="45" preserveRatio="true">
                    <image>
                        <Image url="@../images/lamma-logo.png" />
                    </image>
                </ImageView>
                <Label style="-fx-font-size: 28; -fx-text-fill: white;" styleClass="section-title" text="LAMA EXPEDITION" />
                <Region HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="roleCombo" prefWidth="160" promptText="Select Role" styleClass="modern-input" />
                <Region minWidth="20" />
                <Label fx:id="userLabel" style="-fx-text-fill: #3b82f6;" styleClass="section-subtitle" text="Active Scout: Explorer" />
            </HBox>
    </top>

    <center>
        <StackPane prefHeight="1112.0" prefWidth="2019.0">
            <!-- Global Nature Background -->
            <ImageView fitHeight="1080" fitWidth="1920" preserveRatio="false">
                <image>
                    <Image url="@../usersaif/roaming_revolution-camping-6626537_1920.jpg" />
                </image>
            </ImageView>
            <StackPane style="-fx-background-color: rgba(10, 15, 13, 0.85);" />

            <StackPane fx:id="contentPane">
                <!-- ... existing content ... -->
                <ScrollPane fx:id="dashboardScroll" fitToWidth="true" hbarPolicy="AS_NEEDED" styleClass="modern-scroll">
                    <FlowPane fx:id="cardsContainer" hgap="25" style="-fx-padding: 40;" vgap="25" />
                </ScrollPane>
                <ScrollPane fx:id="userDashboardScroll" fitToWidth="true" hbarPolicy="AS_NEEDED" managed="false" style="-fx-background: transparent; -fx-background-color: transparent;" styleClass="modern-scroll" visible="false">
                    <fx:include fx:id="espaceUtilisateurInclude" source="utilisateur/espace-utilisateur.fxml" />
                </ScrollPane>
                <BorderPane fx:id="moduleContentPane" managed="false" style="-fx-background-color: transparent;" visible="false">
                    <top>
                        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 10 20;">
                            <Button fx:id="backButton" onAction="#retourDashboard" styleClass="button-capsule-glass" text="← Back" />
                            <Label fx:id="moduleTitleLabel" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;" text="Module Title" />
                        </HBox>
                    </top>
                    <center>
                        <ScrollPane fitToHeight="false" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: transparent; -fx-background-color: transparent;" vbarPolicy="AS_NEEDED">
                            <StackPane fx:id="moduleStackPane" />
                        </ScrollPane>
                    </center>
                </BorderPane>

                <!-- Floating Chatbot Button -->
                <StackPane pickOnBounds="false">
                    <Button onAction="#openChatbot" style="-fx-background-color: #1890ff; -fx-background-radius: 50; -fx-min-width: 60; -fx-min-height: 60; -fx-max-width: 60; -fx-max-height: 60; -fx-font-size: 24; -fx-effect: dropshadow(gaussian, rgba(24, 144, 255, 0.5), 15, 0, 0, 0);" styleClass="button-capsule" text="🤖" StackPane.alignment="BOTTOM_RIGHT">
                        <StackPane.margin>
                            <Insets bottom="30" right="30" />
                        </StackPane.margin>
                    </Button>
                </StackPane>
            </StackPane>
        </StackPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" prefHeight="67.0" prefWidth="3021.0" spacing="12" styleClass="voyage-footer">
            <padding>
                <Insets bottom="10" left="24" right="24" top="10" />
            </padding>
            <Label fx:id="statusLabel" styleClass="voyage-status" text="Pret - Selectionnez un module" />
        </HBox>
    </bottom>
</BorderPane>
