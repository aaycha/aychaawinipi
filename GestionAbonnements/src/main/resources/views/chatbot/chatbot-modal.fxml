<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestion.controllers.chatbot.ChatbotController"
      spacing="0" prefWidth="600" prefHeight="500" maxWidth="620" maxHeight="500"
      minWidth="400" minHeight="450"
      style="-fx-background-color: linear-gradient(to bottom right, #f8fafc, #ffffff); -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 20, 0, 0, 4);">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="12"
          style="-fx-background-color: linear-gradient(to right, #0f172a, #1e293b); -fx-padding: 12; -fx-background-radius: 16 16 0 0;">
        <StackPane>
            <Circle fill="white" radius="18" style="-fx-opacity: 0.12;"/>
            <Label text="🤖" style="-fx-font-size: 24;"/>
        </StackPane>
        <VBox spacing="2">
            <Label text="LAMA Navigator"
                   style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 17;"/>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Circle fill="#22c55e" radius="4"/>
                <Label text="AI Active • Secure Signal"
                       style="-fx-text-fill: #94a3b8; -fx-font-size: 11;"/>
            </HBox>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="🏔️" style="-fx-font-size: 22; -fx-opacity: 0.4;"/>
    </HBox>

    <!-- Chat Area - takes all remaining space -->
    <ScrollPane fx:id="scrollPane"
                VBox.vgrow="ALWAYS"
                fitToWidth="true" fitToHeight="false"
                hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox fx:id="chatContainer" spacing="10" style="-fx-padding: 12 15;"/>
    </ScrollPane>

    <!-- Quick Actions - fixed height -->
    <HBox alignment="CENTER" spacing="10" VBox.vgrow="NEVER"
          style="-fx-padding: 10 16; -fx-background-color: rgba(248, 250, 252, 0.9); -fx-min-height: 44; -fx-pref-height: 44;">
        <Button text="🍴 Menu du jour" onAction="#handleQuickAction"
                styleClass="button-capsule-glass"
                style="-fx-font-size: 11; -fx-padding: 6 12; -fx-text-fill: #1e293b; -fx-border-color: #cbd5e1;"/>
        <Button text="🏜️ Mes Pass" onAction="#handleQuickAction"
                styleClass="button-capsule-glass"
                style="-fx-font-size: 11; -fx-padding: 6 12; -fx-text-fill: #1e293b; -fx-border-color: #cbd5e1;"/>
        <Button text="⚠️ Allergies" onAction="#handleQuickAction"
                styleClass="button-capsule-glass"
                style="-fx-font-size: 11; -fx-padding: 6 12; -fx-text-fill: #1e293b; -fx-border-color: #cbd5e1;"/>
    </HBox>

    <!-- Input Area - fixed height, always visible -->
    <HBox spacing="10" alignment="CENTER" VBox.vgrow="NEVER"
          style="-fx-padding: 12 16; -fx-background-color: white; -fx-border-color: #f1f5f9; -fx-border-width: 1 0 0 0; -fx-background-radius: 0 0 16 16; -fx-min-height: 56; -fx-pref-height: 56;">
        <TextField fx:id="inputField" HBox.hgrow="ALWAYS"
                   promptText="Pose ta question..."
                   onAction="#handleSendMessage"
                   style="-fx-background-color: #f8fafc; -fx-background-radius: 10; -fx-padding: 10 14; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-font-size: 13;"/>
        <Button onAction="#handleSendMessage" text="SEND"
                styleClass="button-capsule"
                style="-fx-background-color: #22c55e; -fx-text-fill: white; -fx-padding: 10 18; -fx-font-weight: bold; -fx-font-size: 13; -fx-background-radius: 10;"/>
    </HBox>

</VBox>