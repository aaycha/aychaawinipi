<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import java.net.URL?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestion.ui.menu.MenuFormController"
            fitToWidth="false" fitToHeight="false" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED"
            style="-fx-background: transparent; -fx-background-color: transparent;">

    <VBox spacing="8" style="-fx-background-color: #0f172a; -fx-padding: 10;" prefWidth="750" maxWidth="800" styleClass="modern-panel">
        <stylesheets>
            <URL value="@../../styles/nature-mood.css" />
            <URL value="@../../styles/card-view.css" />
        </stylesheets>

        <!-- Header -->
        <HBox spacing="8" alignment="CENTER_LEFT">
            <StackPane style="-fx-background-color: rgba(34, 197, 94, 0.15); -fx-background-radius: 8; -fx-padding: 5;">
                <Label text="📋" style="-fx-font-size: 14px;"/>
            </StackPane>
            <VBox spacing="0">
                <Label fx:id="formTitle" text="Nouveau Menu" style="-fx-font-size: 14px; -fx-font-weight: 800; -fx-text-fill: white;"/>
                <Label text="Définissez les informations du menu" style="-fx-font-size: 8.5px; -fx-text-fill: #94a3b8;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <!-- Form Card -->
        <VBox spacing="10" styleClass="glass-panel" style="-fx-padding: 12;">
            <!-- Section: Informations du Menu -->
            <VBox spacing="8">
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Label text="🍽️" style="-fx-font-size: 14px;"/>
                    <Label text="Informations du Menu" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                </HBox>

                <GridPane hgap="12" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints minWidth="100" prefWidth="120" halignment="RIGHT"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="250"/>
                    </columnConstraints>

                    <!-- Nom (obligatoire) -->
                    <Label text="Nom * :" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #94a3b8; -fx-font-size: 10;"/>
                    <VBox spacing="2" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <TextField fx:id="inputNom" promptText="Ex: Menu du Jour..."
                                   styleClass="modern-input" style="-fx-font-size: 10px;"/>
                        <Label fx:id="hintNom" text="0 / 100 car. — Obligatoire" style="-fx-text-fill: #64748b; -fx-font-size: 9px;"/>
                        <Label fx:id="errorNom" text="" visible="false" managed="false"
                               style="-fx-text-fill: #ef4444; -fx-font-size: 10px;"/>
                    </VBox>

                    <!-- Restaurant (obligatoire) -->
                    <Label text="Restaurant * :" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #94a3b8; -fx-font-size: 10;"/>
                    <VBox spacing="2" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <ComboBox fx:id="comboRestaurant" promptText="Sélectionnez un restaurant"
                                  styleClass="modern-input" style="-fx-font-size: 10px;" maxWidth="Infinity"/>
                        <Label fx:id="errorRestaurant" text="" visible="false" managed="false"
                               style="-fx-text-fill: #ef4444; -fx-font-size: 10px;"/>
                    </VBox>

                    <!-- Prix (obligatoire) -->
                    <Label text="Prix (€) * :" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold; -fx-text-fill: #94a3b8; -fx-font-size: 10;"/>
                    <VBox spacing="2" GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <TextField fx:id="inputPrix" promptText="Ex: 15.00"
                                   styleClass="modern-input" style="-fx-font-size: 10px;"/>
                        <Label fx:id="hintPrix" text="Obligatoire" style="-fx-text-fill: #64748b; -fx-font-size: 9px;"/>
                        <Label fx:id="errorPrix" text="" visible="false" managed="false"
                               style="-fx-text-fill: #ef4444; -fx-font-size: 10px;"/>
                    </VBox>
                </GridPane>
            </VBox>

            <Separator style="-fx-opacity: 0.1;"/>

            <!-- Section: Description -->
            <VBox spacing="8">
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Label text="📝" style="-fx-font-size: 14px;"/>
                    <Label text="Description" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                </HBox>

                <GridPane hgap="12" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints minWidth="100" prefWidth="120" halignment="RIGHT"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="250"/>
                    </columnConstraints>

                    <Label text="Description :" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-text-fill: #94a3b8; -fx-font-size: 10;"/>
                    <VBox spacing="2" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <TextArea fx:id="inputDescription" promptText="Ex: Détails du menu..."
                                  wrapText="true" prefRowCount="2"
                                  styleClass="modern-input" style="-fx-font-size: 10px;"/>
                    </VBox>
                </GridPane>
            </VBox>

            <!-- Buttons -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button text="💾 Enregistrer" onAction="#onEnregistrer"
                        styleClass="button-capsule" style="-fx-padding: 8 20; -fx-font-size: 10px;"/>
                <Button text="❌ Annuler" onAction="#onAnnuler"
                        styleClass="button-capsule-glass" style="-fx-padding: 8 20; -fx-font-size: 10px;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="* Obligatoire" style="-fx-text-fill: #64748b; -fx-font-size: 9px;"/>
            </HBox>
        </VBox>
    </VBox>
</ScrollPane>
