<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import java.net.URL?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestion.ui.menu.MenuFormController"
            fitToWidth="true" fitToHeight="false" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED"
            styleClass="rimberio-root">

    <stylesheets>
        <URL value="@../../styles/cafe-rimberio.css" />
    </stylesheets>

    <StackPane style="-fx-padding: 60; -fx-background-color: transparent;">
        <VBox spacing="40" maxWidth="1000" styleClass="rimberio-main-panel" alignment="TOP_CENTER" style="-fx-padding: 60;">
            
            <!-- Header -->
            <VBox spacing="15" alignment="CENTER">
                <Label text="{MENU}" style="-fx-font-family: 'Georgia'; -fx-font-size: 56; -fx-text-fill: #1d3c34; -fx-font-weight: bold;"/>
                <Label fx:id="formTitle" text="NOUVEAU MENU" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #5e7d75; -fx-letter-spacing: 4;"/>
                <Label text="L'expérience culinaire Lamma Explorer" style="-fx-font-size: 15; -fx-text-fill: #1d3c34; -fx-font-style: italic;"/>
            </VBox>

            <Separator style="-fx-opacity: 0.1; -fx-background-color: #1d3c34;"/>

            <!-- ═══ GLOBAL ERROR CONTAINER ═══ -->
            <VBox fx:id="errorContainer" spacing="4" visible="false" managed="false"
                  style="-fx-background-color: #fee2e2; -fx-border-color: #ef4444; -fx-border-radius: 15; -fx-background-radius: 15; -fx-padding: 20;">
                <Label text="⚠ Erreurs de validation" style="-fx-font-weight: bold; -fx-text-fill: #ef4444; -fx-font-size: 14;"/>
                <Label fx:id="globalErrorMessage" text="" wrapText="true" style="-fx-text-fill: #b91c1c; -fx-font-size: 13;"/>
            </VBox>

            <!-- Section: {GENERAL} -->
            <VBox spacing="30" alignment="TOP_CENTER" maxWidth=" Infinity">
                <Label text="{INFORMATIONS GÉNÉRALES}" styleClass="rimberio-section-header" style="-fx-font-size: 24;"/>
                
                <GridPane hgap="40" vgap="25">
                    <columnConstraints>
                        <ColumnConstraints minWidth="180" halignment="RIGHT"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <!-- Nom -->
                    <Label text="NOM DU MENU :" GridPane.columnIndex="0" GridPane.rowIndex="0" 
                           style="-fx-font-weight: bold; -fx-text-fill: #1d3c34; -fx-font-size: 14;"/>
                    <VBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <TextField fx:id="inputNom" promptText="Saisissez le nom du menu..." 
                                       HBox.hgrow="ALWAYS" styleClass="rimberio-input" 
                                       style="-fx-font-size: 18; -fx-min-height: 50;"/>
                            <Button fx:id="btnGenerateNameIA" text="✨ IA" onAction="#onGenerateNameIA" 
                                    styleClass="button-rimberio-ia" style="-fx-font-size: 14; -fx-padding: 10 20;"/>
                            <ProgressIndicator fx:id="nameAiProgress" visible="false" managed="false" prefWidth="25" prefHeight="25"/>
                        </HBox>
                        <Label fx:id="hintNom" text="0 / 100 car." style="-fx-text-fill: #5e7d75; -fx-font-size: 12;"/>
                        <Label fx:id="errorNom" text="" visible="false" managed="false" style="-fx-text-fill: #ef4444; -fx-font-size: 12;"/>
                    </VBox>

                    <!-- Restaurant -->
                    <Label text="RESTAURANT :" GridPane.columnIndex="0" GridPane.rowIndex="1" 
                           style="-fx-font-weight: bold; -fx-text-fill: #1d3c34; -fx-font-size: 14;"/>
                    <VBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <ComboBox fx:id="comboRestaurant" prefWidth="Infinity" promptText="Choisir un établissement" 
                                  styleClass="rimberio-input" style="-fx-font-size: 18; -fx-min-height: 50;"/>
                        <Label fx:id="errorRestaurant" text="" visible="false" managed="false" style="-fx-text-fill: #ef4444; -fx-font-size: 12;"/>
                    </VBox>

                    <!-- Statut -->
                    <Label text="VISIBILITÉ :" GridPane.columnIndex="0" GridPane.rowIndex="2" 
                           style="-fx-font-weight: bold; -fx-text-fill: #1d3c34; -fx-font-size: 14;"/>
                    <CheckBox fx:id="checkActif" text="Menu disponible et actif immédiatement" GridPane.columnIndex="1" GridPane.rowIndex="2" 
                              style="-fx-text-fill: #1d3c34; -fx-font-size: 16; -fx-font-weight: bold;"/>
                </GridPane>
            </VBox>

            <Separator style="-fx-opacity: 0.1; -fx-background-color: #1d3c34;"/>

            <!-- Section: {PERIOD} -->
            <VBox spacing="30" alignment="TOP_CENTER">
                <HBox spacing="20" alignment="CENTER">
                    <Label text="{PÉRIODE DE VALIDITÉ}" styleClass="rimberio-section-header" style="-fx-font-size: 24;"/>
                    <Button fx:id="btnGenerateDatesIA" text="✨ Proposer Dates" onAction="#onGenerateDatesIA" 
                            styleClass="button-rimberio-ia" style="-fx-font-size: 14; -fx-padding: 10 25;"/>
                    <ProgressIndicator fx:id="datesAiProgress" visible="false" managed="false" prefWidth="25" prefHeight="25"/>
                </HBox>

                <GridPane hgap="40" vgap="25">
                    <columnConstraints>
                        <ColumnConstraints minWidth="180" halignment="RIGHT"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="DATE DE DÉBUT :" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-text-fill: #1d3c34; -fx-font-weight: bold; -fx-font-size: 14;"/>
                    <DatePicker fx:id="inputDateDebut" styleClass="rimberio-input" maxWidth="Infinity" 
                                GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-font-size: 18; -fx-min-height: 50;"/>

                    <Label text="DATE DE FIN :" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-text-fill: #1d3c34; -fx-font-weight: bold; -fx-font-size: 14;"/>
                    <DatePicker fx:id="inputDateFin" styleClass="rimberio-input" maxWidth="Infinity" 
                                GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-font-size: 18; -fx-min-height: 50;"/>

                    <Label fx:id="errorDates" text="" visible="false" managed="false" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-text-fill: #ef4444; -fx-font-size: 12;"/>
                </GridPane>
            </VBox>

            <!-- Section: {COMPOSITION} -->
            <VBox spacing="25" alignment="TOP_CENTER" style="-fx-background-color: #f0f7f4; -fx-padding: 40; -fx-background-radius: 40;">
                <Label text="{COMPOSITION DU MENU}" styleClass="rimberio-section-header" style="-fx-font-size: 24;"/>
                <Label text="Sélectionnez les plats emblématiques pour ce voyage gustatif :" style="-fx-font-size: 14; -fx-text-fill: #5e7d75;"/>
                
                <ScrollPane prefHeight="350" fitToWidth="true" styleClass="rimberio-scroll" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 15;">
                    <VBox fx:id="dishesSelectionList" spacing="20" style="-fx-padding: 15;"/>
                </ScrollPane>

                <HBox spacing="20" alignment="CENTER">
                    <Button fx:id="btnGenerateDescIA" text="✨ Rédiger une description poétique" onAction="#onGenerateDescriptionIA" 
                            styleClass="button-rimberio-ia" style="-fx-background-color: #1d3c34; -fx-text-fill: white; -fx-font-size: 15; -fx-padding: 12 30;"/>
                    <ProgressIndicator fx:id="descAiProgress" visible="false" managed="false" prefWidth="30" prefHeight="30"/>
                </HBox>
            </VBox>

            <!-- Section: {DESCRIPTION} -->
            <VBox spacing="20" alignment="TOP_CENTER">
                <Label text="{POÉSIE CULINAIRE}" styleClass="rimberio-section-header" style="-fx-font-size: 24;"/>
                <TextArea fx:id="inputDescription" promptText="Racontez l'histoire de ce menu..."
                          prefRowCount="10" wrapText="true" styleClass="rimberio-input" 
                          style="-fx-min-height: 220; -fx-font-size: 18;"/>
                <Label fx:id="errorDescription" text="" visible="false" managed="false" style="-fx-text-fill: #ef4444; -fx-font-size: 12;"/>
            </VBox>

            <Separator style="-fx-opacity: 0.1; -fx-background-color: #1d3c34;"/>

            <!-- Action Buttons -->
            <HBox spacing="30" alignment="CENTER">
                <Button text="💾 ENREGISTRER" onAction="#onEnregistrer" styleClass="button-rimberio" 
                        style="-fx-font-size: 18; -fx-padding: 15 60; -fx-background-radius: 30;"/>
                <Button fx:id="btnGenerateCard" text="🎨 CARTE PRÉSENTATION" onAction="#onGenerateMenuCard" 
                        styleClass="button-rimberio-outline" style="-fx-font-size: 16; -fx-padding: 15 40; -fx-background-radius: 30;"/>
                <Button text="❌ QUITTER" onAction="#onAnnuler" styleClass="button-rimberio-outline" 
                        style="-fx-border-color: #ef4444; -fx-text-fill: #ef4444; -fx-font-size: 16; -fx-padding: 15 40; -fx-background-radius: 30;"/>
            </HBox>
            
            <Label text="123 LAMMA ST., EXPLORER CITY | LAMMA-RESTAURANT.COM" 
                   style="-fx-font-size: 13; -fx-text-fill: #5e7d75; -fx-letter-spacing: 3; -fx-font-weight: bold;"/>
        </VBox>
    </StackPane>
</ScrollPane>
