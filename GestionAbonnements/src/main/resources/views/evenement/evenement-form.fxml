<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<ScrollPane xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestion.ui.evenement.EvenementFormController"
            fitToWidth="true" styleClass="modern-scroll"
            style="-fx-background: transparent; -fx-background-color: transparent;">
    <stylesheets>
        <URL value="@../../styles/nature-mood.css" />
    </stylesheets>
    
    <VBox spacing="10" styleClass="modern-panel" style="-fx-padding: 15; -fx-background-color: #0f172a;">

    <Label fx:id="mainTitle" text="Nouvel Événement" styleClass="modern-title" style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: 800;"/>

    <GridPane hgap="15" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="80" prefWidth="100"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Titre:" style="-fx-text-fill: #94A3B8; -fx-font-size: 11;" GridPane.rowIndex="0"/>
        <TextField fx:id="titleField" promptText="Nom de l'événement" styleClass="modern-input" style="-fx-font-size: 11;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Description:" style="-fx-text-fill: #94A3B8; -fx-font-size: 11;" GridPane.rowIndex="1"/>
        <TextArea fx:id="descField" promptText="Détails de l'événement" styleClass="modern-input" prefHeight="60" style="-fx-font-size: 11;" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Type:" style="-fx-text-fill: #94A3B8; -fx-font-size: 11;" GridPane.rowIndex="2"/>
        <ComboBox fx:id="typeCombo" prefWidth="Infinity" styleClass="modern-input" style="-fx-font-size: 11;" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Lieu:" style="-fx-text-fill: #94A3B8; -fx-font-size: 11;" GridPane.rowIndex="3"/>
        <TextField fx:id="locationField" promptText="Emplacement" styleClass="modern-input" style="-fx-font-size: 11;" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <Label text="Date Début:" style="-fx-text-fill: #94A3B8; -fx-font-size: 11;" GridPane.rowIndex="4"/>
        <DatePicker fx:id="startDatePicker" prefWidth="Infinity" styleClass="modern-input" style="-fx-font-size: 11;" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

        <Label text="Date Fin:" style="-fx-text-fill: #94A3B8; -fx-font-size: 11;" GridPane.rowIndex="5"/>
        <DatePicker fx:id="endDatePicker" prefWidth="Infinity" styleClass="modern-input" style="-fx-font-size: 11;" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 5 0 0 0;">
        <Button text="Annuler" onAction="#onCancel" styleClass="button-capsule-glass" prefWidth="80" style="-fx-font-size: 11; -fx-padding: 6 12;"/>
        <Button text="Enregistrer" onAction="#onSave" styleClass="button-capsule" prefWidth="100" style="-fx-font-size: 11; -fx-padding: 6 15;"/>
    </HBox>

    </VBox>
</ScrollPane>
