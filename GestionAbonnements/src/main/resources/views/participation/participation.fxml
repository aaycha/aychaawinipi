<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.*?>
<?import java.net.URL?>

<ScrollPane xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestion.ui.participation.ParticipationViewController"
            fitToWidth="false" fitToHeight="false" styleClass="modern-scroll-pane"
            vbarPolicy="AS_NEEDED" hbarPolicy="AS_NEEDED">
    <stylesheets>
        <URL value="@../../styles/card-view.css" />
        <URL value="@../../styles/nature-mood.css" />
    </stylesheets>

    <VBox spacing="8" styleClass="modern-panel" prefWidth="1000" style="-fx-padding: 12;">
        
        <!-- Nature Header -->
        <HBox spacing="12" alignment="CENTER_LEFT">
            <StackPane style="-fx-background-color: rgba(59, 130, 246, 0.15); -fx-background-radius: 8; -fx-padding: 6;">
                <Label text="🤝" style="-fx-font-size: 16;"/>
            </StackPane>
            <VBox spacing="0">
                <Label text="Group Expeditions" styleClass="modern-title" style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: 800;"/>
                <Label text="Track community involvement and group treks" style="-fx-text-fill: #94a3b8; -fx-font-size: 9;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER" spacing="8" style="-fx-background-color: rgba(255,255,255,0.05); -fx-padding: 4 12; -fx-background-radius: 15; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 15;">
                <Circle fill="#3b82f6" radius="3"/>
                <Label fx:id="statusInfoLabel" text="Logistics Ready" style="-fx-text-fill: white; -fx-font-size: 10; -fx-font-weight: 600;"/>
            </HBox>
        </HBox>

        <!-- Action Bar - Capsule Style -->
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 2 0;">
            <Button text="➕ NEW" onAction="#onNouvelle" styleClass="button-capsule" style="-fx-padding: 8 16; -fx-font-size: 11;"/>
            <Button text="🔄 SYNC" onAction="#onActualiser" styleClass="button-capsule-glass" style="-fx-padding: 8 16; -fx-font-size: 11;"/>
            <Button fx:id="btnModifier" text="✏️ EDIT" onAction="#onModifier" disable="true" styleClass="button-capsule-glass" style="-fx-padding: 8 16; -fx-font-size: 11;"/>
            <Button fx:id="btnSupprimer" text="🗑️ PURGE" onAction="#onSupprimer" disable="true" styleClass="button-capsule-glass" style="-fx-padding: 8 16; -fx-text-fill: #ef4444; -fx-font-size: 11;"/>
            <Button fx:id="btnConfirmer" text="✅ APPROVE" onAction="#onConfirmer" disable="true" styleClass="button-capsule-glass" style="-fx-padding: 8 16; -fx-text-fill: #22c55e; -fx-font-size: 11;"/>
            <Button fx:id="btnAnnulerPart" text="❌ ABORT" onAction="#onAnnulerParticipation" disable="true" styleClass="button-capsule-glass" style="-fx-padding: 8 16; -fx-text-fill: #64748b; -fx-font-size: 11;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="📊 STATS" onAction="#onStatistiques" styleClass="button-capsule-glass" style="-fx-padding: 8 16; -fx-font-size: 11;"/>
        </HBox>

        <!-- Filter Grid - Glass -->
        <VBox spacing="10" styleClass="modern-card" style="-fx-padding: 15;">
            <Label text="🔍 Scout Search" styleClass="section-title" style="-fx-font-size: 14; -fx-text-fill: white;"/>
            <GridPane hgap="15" vgap="12">
                <columnConstraints>
                    <ColumnConstraints minWidth="100" prefWidth="120"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints minWidth="100" prefWidth="120"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Sync Status:" style="-fx-text-fill: #94a3b8; -fx-font-weight: 700; -fx-font-size: 11;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <ComboBox fx:id="filterStatut" prefWidth="300" promptText="All Statuses"
                          styleClass="modern-input" onAction="#onFiltrer" style="-fx-font-size: 11;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Camp Type:" style="-fx-text-fill: #94a3b8; -fx-font-weight: 700; -fx-font-size: 11;" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <ComboBox fx:id="filterType" prefWidth="300" promptText="All Types"
                          styleClass="modern-input" onAction="#onFiltrer" style="-fx-font-size: 11;" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                <Label text="Scout ID:" style="-fx-text-fill: #94a3b8; -fx-font-weight: 700; -fx-font-size: 11;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="filterUserId" promptText="Search ID..."
                           styleClass="modern-input" onKeyReleased="#onFiltrer" style="-fx-font-size: 11;" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Trek ID:" style="-fx-text-fill: #94a3b8; -fx-font-weight: 700; -fx-font-size: 11;" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <TextField fx:id="filterEvenementId" promptText="Search Trek..."
                           styleClass="modern-input" onKeyReleased="#onFiltrer" style="-fx-font-size: 11;" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                <Label text="Main Search:" style="-fx-text-fill: #94a3b8; -fx-font-weight: 700; -fx-font-size: 11;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="searchField" promptText="Search everything on the trail..."
                           styleClass="modern-input" onKeyReleased="#onRechercher" style="-fx-font-size: 11;" GridPane.columnIndex="1" GridPane.rowIndex="2" GridPane.columnSpan="3"/>
            </GridPane>
        </VBox>

        <!-- Registries List -->
        <VBox spacing="10" VBox.vgrow="ALWAYS">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="📍 Active Registries" styleClass="section-title" style="-fx-font-size: 14; -fx-text-fill: white;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="countLabel" text="0 records located" style="-fx-text-fill: #3b82f6; -fx-font-weight: 800; -fx-font-size: 10; -fx-background-color: rgba(59, 130, 246, 0.1); -fx-padding: 3 10; -fx-background-radius: 10;"/>
            </HBox>

            <ListView fx:id="listView" VBox.vgrow="ALWAYS" minHeight="300"
                       styleClass="modern-list-view" onMouseClicked="#onListClick">
                <placeholder>
                    <VBox alignment="CENTER" spacing="10" style="-fx-padding: 30;">
                        <Label text="⛺" style="-fx-font-size: 32;"/>
                        <Label text="The trail is empty" style="-fx-text-fill: #94a3b8; -fx-font-size: 14; -fx-font-weight: 600;"/>
                        <Label text="Sync your scout logs or register a new trek" style="-fx-text-fill: #64748b; -fx-font-size: 11;"/>
                    </VBox>
                </placeholder>
            </ListView>
        </VBox>

        <!-- Hidden inputs for logic -->
        <VBox visible="false" managed="false">
            <TextField fx:id="inputUserId"/>
            <TextField fx:id="inputEvenementId"/>
            <ComboBox fx:id="inputType"/>
            <ComboBox fx:id="inputContexte"/>
            <CheckBox fx:id="inputHebergement"/>
            <TextField fx:id="inputHebergementNuits"/>
            <Button fx:id="btnEnregistrer" onAction="#onEnregistrer"/>
            <Button fx:id="btnModifierForm" onAction="#onModifier"/>
            <Label fx:id="validationMessage"/>
        </VBox>
    </VBox>

</ScrollPane>
