<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestion.ui.abonnement.AbonnementFormController"
            fitToWidth="true" fitToHeight="false" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED"
            style="-fx-background: transparent; -fx-background-color: transparent;"
            stylesheets="@../../styles/nature-mood.css, @../../styles/card-view.css">

    <StackPane style="-fx-background-color: transparent; -fx-padding: 5;">
        <VBox spacing="4" styleClass="glass-panel" prefWidth="800" maxWidth="850" alignment="TOP_CENTER" style="-fx-padding: 8;">
            
            <!-- Header Section -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <StackPane style="-fx-background-color: rgba(250, 146, 68, 0.15); -fx-background-radius: 8; -fx-padding: 6;">
                    <Label text="✨" style="-fx-font-size: 16;"/>
                </StackPane>
                <VBox spacing="0">
                    <Label fx:id="mainTitle" text="Configuration Master"
                           style="-fx-font-size: 14px; -fx-font-weight: 800; -fx-text-fill: white;"/>
                    <Label text="Scout Intel v2.0 • Optimizing expedition access" style="-fx-font-size: 8px; -fx-text-fill: #94a3b8;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <ToggleButton fx:id="iaToggleInForm" selected="true" text="SCOUT IA ACTIVE" styleClass="button-capsule-glass" style="-fx-text-fill: #22c55e; -fx-font-size: 9; -fx-font-weight: 900; -fx-padding: 4 12;"/>
            </HBox>

            <Separator style="-fx-opacity: 0.1;"/>

            <GridPane hgap="20" vgap="0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="65"/>
                    <ColumnConstraints percentWidth="35"/>
                </columnConstraints>

                <!-- LEFT: CORE FORM -->
                <VBox GridPane.columnIndex="0" spacing="8">
                    <!-- Error Terminal -->
                    <VBox fx:id="validationContainer" visible="false" managed="false" style="-fx-background-color: rgba(239, 68, 68, 0.1); -fx-padding: 10; -fx-background-radius: 10; -fx-border-color: rgba(239, 68, 68, 0.2); -fx-border-radius: 10;">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="⚠️" style="-fx-font-size: 14px;"/>
                            <Label fx:id="validationMessage" text="Scout error: Correct coordinates before establishing." style="-fx-text-fill: #ef4444; -fx-font-weight: 900; -fx-font-size: 11px;"/>
                        </HBox>
                    </VBox>

                    <!-- Identity Section -->
                    <VBox spacing="6" styleClass="modern-card" style="-fx-padding: 8;">
                        <Label text="🛡️ PASS IDENTIFICATION" style="-fx-font-weight: 900; -fx-text-fill: #3b82f6; -fx-font-size: 9; -fx-letter-spacing: 0.5px;"/>
                        
                        <VBox spacing="6">
                            <VBox spacing="2">
                                <TextField fx:id="inputNom" promptText="Enter pass name (e.g. Abonnement Lune)..." styleClass="modern-input" style="-fx-font-size: 12px; -fx-font-weight: 800;"/>
                            </VBox>
                            <VBox spacing="3">
                                <HBox spacing="10">
                                    <ComboBox fx:id="inputType" promptText="Engagement Type" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="modern-input" style="-fx-font-size: 11;"/>
                                </HBox>
                            </VBox>
                        </VBox>
                    </VBox>

                    <!-- Metrics Section -->
                    <VBox spacing="6" styleClass="modern-card" style="-fx-padding: 8;">
                        <Label text="📊 EXPLOITATION METRICS" style="-fx-font-weight: 900; -fx-text-fill: #FACC15; -fx-font-size: 9; -fx-letter-spacing: 0.5px;"/>
                        
                        <HBox spacing="12">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Scout Classification:" style="-fx-text-fill: #94a3b8; -fx-font-weight: 700; -fx-font-size: 9;"/>
                                <ComboBox fx:id="comboRestriction" promptText="Event Restriction" maxWidth="Infinity" styleClass="modern-input" style="-fx-font-size: 10;"/>
                                <ComboBox fx:id="inputStatut" promptText="Access Status" maxWidth="Infinity" styleClass="modern-input" style="-fx-font-size: 10;"/>
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Mission Logistics:" style="-fx-text-fill: #94a3b8; -fx-font-weight: 700; -fx-font-size: 9;"/>
                                <TextField fx:id="inputPrix" promptText="Tarification (€)" styleClass="modern-input" style="-fx-font-size: 10;"/>
                                <HBox spacing="5" alignment="CENTER_LEFT">
                                    <CheckBox fx:id="inputAutoRenew" text="AUTO-RENEW" selected="true" style="-fx-text-fill: #22c55e; -fx-font-weight: 900; -fx-font-size: 10;"/>
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Dynamic Coverage Section -->
                    <VBox fx:id="eventSelectionContainer" managed="false" visible="false" spacing="8" styleClass="modern-card" style="-fx-padding: 10;">
                        <Label text="📍 SPECIFIC COÖRDINATES" style="-fx-font-weight: 900; -fx-text-fill: #22c55e; -fx-font-size: 9; -fx-letter-spacing: 0.5px;"/>
                        <ComboBox fx:id="comboEvent" promptText="Choose target adventure..." maxWidth="Infinity" styleClass="modern-input" style="-fx-font-size: 11;"/>
                    </VBox>

                    <!-- Temporality Section -->
                    <VBox spacing="8" styleClass="modern-card" style="-fx-padding: 10;">
                        <Label text="⏳ MISSION TEMPORALITY" style="-fx-font-weight: 900; -fx-text-fill: #F97316; -fx-font-size: 9; -fx-letter-spacing: 0.5px;"/>
                        <HBox spacing="10">
                            <DatePicker fx:id="inputDateDebut" promptText="Inception Date" styleClass="modern-input" HBox.hgrow="ALWAYS" style="-fx-font-size: 10;"/>
                            <DatePicker fx:id="inputDateFin" promptText="Expiration Date" styleClass="modern-input" HBox.hgrow="ALWAYS" style="-fx-font-size: 10;"/>
                        </HBox>
                    </VBox>

                    <!-- Summary / Benefits Area -->
                    <VBox spacing="8" styleClass="modern-card" style="-fx-padding: 15; -fx-background-color: rgba(30, 58, 138, 0.05);">
                        <Label text="📜 MISSION RECAPITULATIF" style="-fx-font-weight: 900; -fx-font-size: 10px; -fx-text-fill: white;"/>
                        <VBox spacing="5">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Coverage:" style="-fx-font-size: 10px; -fx-text-fill: #94a3b8;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="summaryType" text="Accès Global" style="-fx-font-weight: 900; -fx-font-size: 10px; -fx-text-fill: white;"/>
                            </HBox>
                            <Label text="• Unrestricted trail access" style="-fx-font-size: 9px; -fx-text-fill: #d1d5db;"/>
                            <Label text="• Scout insurance coverage" style="-fx-font-size: 9px; -fx-text-fill: #d1d5db;"/>
                        </VBox>
                    </VBox>

                    <!-- Actions -->
                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Button fx:id="btnSave" text="💾 CONFIRM MASTER" onAction="#onSave" styleClass="button-capsule" style="-fx-padding: 8 20; -fx-font-size: 11;"/>
                        <Button text="❌ ABORT" onAction="#onCancel" styleClass="button-capsule-glass" style="-fx-padding: 8 18; -fx-font-size: 11;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="statusMessage" text="Awaiting scout intel..." style="-fx-text-fill: #64748b; -fx-font-size: 9px; -fx-font-style: italic;"/>
                    </HBox>
                </VBox>

                <!-- RIGHT: IA TRENDS -->
                <VBox GridPane.columnIndex="1" spacing="15">
                    <VBox spacing="15" styleClass="modern-card" style="-fx-padding: 20; -fx-background-color: rgba(30, 58, 138, 0.05);">
                        <Label text="MISSION TRENDS" style="-fx-font-weight: 900; -fx-font-size: 12px; -fx-text-fill: white;"/>
                        
                        <VBox spacing="10">
                            <Label text="EXPEDITION DEMAND" style="-fx-font-size: 9px; -fx-text-fill: #94a3b8; -fx-font-weight: 900;"/>
                            
                            <VBox spacing="8">
                                <VBox spacing="3" styleClass="modern-card" style="-fx-padding: 10; -fx-background-color: rgba(255,255,255,0.03);">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="🌟 Monthly Pass" style="-fx-font-weight: 900; -fx-font-size: 11px; -fx-text-fill: white;"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label text="+22%" style="-fx-text-fill: #22c55e; -fx-font-size: 9px; -fx-font-weight: 900;"/>
                                    </HBox>
                                    <Label text="Most chosen by seasonal explorers." style="-fx-font-size: 10px; -fx-text-fill: #64748b;" wrapText="true"/>
                                </VBox>

                                <VBox spacing="3" styleClass="modern-card" style="-fx-padding: 10; -fx-background-color: rgba(255,255,255,0.03);">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="🛡️ Extreme Trek" style="-fx-font-weight: 900; -fx-font-size: 11px; -fx-text-fill: white;"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label text="+15%" style="-fx-text-fill: #22c55e; -fx-font-size: 9px; -fx-font-weight: 900;"/>
                                    </HBox>
                                    <Label text="Increasing demand for high-altitude access." style="-fx-font-size: 10px; -fx-text-fill: #64748b;" wrapText="true"/>
                                </VBox>
                            </VBox>
                        </VBox>
                        
                        <Separator style="-fx-opacity: 0.1;"/>
                        
                        <VBox spacing="8">
                            <Label text="LIVE SCOUT INTEL" style="-fx-font-weight: 900; -fx-font-size: 10px; -fx-text-fill: #F97316;"/>
                            <Label fx:id="iaInsightLabel" text="Analyze coordinates for intel." wrapText="true" style="-fx-font-size: 10px; -fx-text-fill: #94a3b8; -fx-font-style: italic;"/>
                        </VBox>
                    </VBox>

                    <!-- Value Proposition Card -->
                    <VBox spacing="12" styleClass="modern-card" style="-fx-padding: 15; -fx-background-color: rgba(34, 197, 94, 0.05); -fx-border-color: rgba(34, 197, 94, 0.1);">
                        <Label text="FUEL VALUES" style="-fx-font-weight: 900; -fx-font-size: 10px; -fx-text-fill: #22c55e;"/>
                        <GridPane hgap="10" vgap="10">
                            <VBox GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="REVENUE" style="-fx-font-size: 8px; -fx-text-fill: #64748b;"/>
                                <Label text="HIGH" style="-fx-font-weight: 900; -fx-font-size: 14px; -fx-text-fill: white;"/>
                            </VBox>
                            <VBox GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="REACH" style="-fx-font-size: 8px; -fx-text-fill: #64748b;"/>
                                <Label text="GLOBAL" style="-fx-font-weight: 900; -fx-font-size: 14px; -fx-text-fill: white;"/>
                            </VBox>
                        </GridPane>
                    </VBox>
                </VBox>
            </GridPane>
        </VBox>
    </StackPane>
</ScrollPane>
