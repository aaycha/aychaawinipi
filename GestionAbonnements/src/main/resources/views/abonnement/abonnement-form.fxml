<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<ScrollPane xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestion.ui.abonnement.AbonnementFormController"
            fitToWidth="true" styleClass="modern-scroll"
            style="-fx-background: transparent; -fx-background-color: transparent;">
    <stylesheets>
        <URL value="@../../styles/nature-mood.css" />
    </stylesheets>
    
    <VBox spacing="15" styleClass="modern-panel" style="-fx-padding: 20; -fx-background-color: #0f172a; -fx-background-radius: 15;">

        <Label fx:id="mainTitle" text="Nouvelle Expédition" styleClass="modern-title" 
               style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: 800;"/>

        <GridPane hgap="15" vgap="12">
            <columnConstraints>
                <ColumnConstraints minWidth="120" prefWidth="140"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="ID Aventurier:" style="-fx-text-fill: #94A3B8; -fx-font-size: 11; -fx-font-weight: bold;" GridPane.rowIndex="0"/>
            <TextField fx:id="inputUserId" promptText="ID du membre" styleClass="modern-input" style="-fx-font-size: 11;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Type de Pass:" style="-fx-text-fill: #94A3B8; -fx-font-size: 11; -fx-font-weight: bold;" GridPane.rowIndex="1"/>
            <ComboBox fx:id="inputType" prefWidth="Infinity" styleClass="modern-input" style="-fx-font-size: 11;" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Date de Début:" style="-fx-text-fill: #94A3B8; -fx-font-size: 11; -fx-font-weight: bold;" GridPane.rowIndex="2"/>
            <DatePicker fx:id="inputDateDebut" prefWidth="Infinity" styleClass="modern-input" style="-fx-font-size: 11;" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="Date de Fin:" style="-fx-text-fill: #94A3B8; -fx-font-size: 11; -fx-font-weight: bold;" GridPane.rowIndex="3"/>
            <DatePicker fx:id="inputDateFin" prefWidth="Infinity" styleClass="modern-input" style="-fx-font-size: 11;" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

            <Label text="Coût ($):" style="-fx-text-fill: #94A3B8; -fx-font-size: 11; -fx-font-weight: bold;" GridPane.rowIndex="4"/>
            <TextField fx:id="inputPrix" promptText="0.00" styleClass="modern-input" style="-fx-font-size: 11;" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

            <Label text="Statut Actuel:" style="-fx-text-fill: #94A3B8; -fx-font-size: 11; -fx-font-weight: bold;" GridPane.rowIndex="5"/>
            <ComboBox fx:id="inputStatut" prefWidth="Infinity" styleClass="modern-input" style="-fx-font-size: 11;" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

            <Label text="Prolongation Auto:" style="-fx-text-fill: #94A3B8; -fx-font-size: 11; -fx-font-weight: bold;" GridPane.rowIndex="6"/>
            <CheckBox fx:id="inputAutoRenew" text="Activer le renouvellement automatique" 
                      style="-fx-text-fill: white; -fx-font-size: 11;" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
        </GridPane>

        <Label fx:id="validationMessage" style="-fx-text-fill: #ef4444; -fx-font-weight: bold; -fx-font-size: 11;" 
               visible="false" managed="false"/>

        <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
            <Button text="Annuler" onAction="#onCancel" styleClass="button-capsule-glass" 
                    prefWidth="100" style="-fx-font-size: 11; -fx-padding: 8 15;"/>
            <Button text="Enregistrer" onAction="#onSave" styleClass="button-capsule" 
                    prefWidth="120" style="-fx-font-size: 11; -fx-padding: 8 20;"/>
        </HBox>

    </VBox>
</ScrollPane>
