<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestion.ui.abonnement.FactureController"
      spacing="0" prefWidth="550" style="-fx-background-color: white;">
    <stylesheets>
        <URL value="@../../styles/nature-mood.css" />
    </stylesheets>

    <!-- Invoice Header (Premium Branding) -->
    <VBox spacing="15" style="-fx-background-color: #0d1210; -fx-padding: 40;">
        <HBox alignment="CENTER_LEFT" spacing="20">
            <StackPane style="-fx-background-color: #fa9244; -fx-background-radius: 10; -fx-padding: 10;">
                <Label text="🦙" style="-fx-font-size: 24; -fx-text-fill: white;"/>
            </StackPane>
            <VBox>
                <Label text="LAMMA EXPÉDITION" style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: bold;"/>
                <Label text="Facture Intelligente" style="-fx-text-fill: #fa9244; -fx-font-size: 14; -fx-letter-spacing: 2;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="TOP_RIGHT">
                <Label fx:id="labelFactureId" text="INV-2026-0001" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                <Label fx:id="labelDate" text="23 Février 2026" style="-fx-text-fill: #9ca3af;"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- Client Info -->
    <HBox spacing="40" style="-fx-padding: 30 40;">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="FACTURÉ À" style="-fx-text-fill: #9ca3af; -fx-font-size: 11; -fx-font-weight: bold;"/>
            <Label fx:id="labelClientName" text="Nom du Client" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
            <Label fx:id="labelClientId" text="ID: 123456" style="-fx-text-fill: #6b7280;"/>
        </VBox>
        <VBox spacing="5" alignment="TOP_RIGHT">
            <Label text="MÉTHODE" style="-fx-text-fill: #9ca3af; -fx-font-size: 11; -fx-font-weight: bold;"/>
            <Label text="Paiement Sécurisé" style="-fx-font-size: 14;"/>
            <Label text="Statut: PAYÉ" style="-fx-text-fill: #10b981; -fx-font-weight: bold;"/>
        </VBox>
    </HBox>

    <Separator style="-fx-padding: 0 40; -fx-opacity: 0.2;"/>

    <!-- Bill Items Table Header -->
    <HBox spacing="10" style="-fx-padding: 20 40; -fx-background-color: #f9fafb;">
        <Label text="DESCRIPTION" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-text-fill: #6b7280; -fx-font-weight: bold; -fx-font-size: 11;"/>
        <Label text="QUANTITÉ" prefWidth="80" alignment="CENTER" style="-fx-text-fill: #6b7280; -fx-font-weight: bold; -fx-font-size: 11;"/>
        <Label text="TOTAL" prefWidth="100" alignment="CENTER_RIGHT" style="-fx-text-fill: #6b7280; -fx-font-weight: bold; -fx-font-size: 11;"/>
    </HBox>

    <!-- Bill Item -->
    <HBox spacing="10" style="-fx-padding: 20 40;">
        <VBox HBox.hgrow="ALWAYS">
            <Label fx:id="labelItemTitle" text="Pass Expédition Unique" style="-fx-font-weight: bold; -fx-font-size: 15;"/>
            <Label fx:id="labelItemDesc" text="Accès valide pour l'événement spécifié" style="-fx-text-fill: #9ca3af; -fx-font-size: 12;"/>
        </VBox>
        <Label text="1" prefWidth="80" alignment="CENTER" style="-fx-font-size: 14;"/>
        <Label fx:id="labelItemPrice" text="0.00 €" prefWidth="100" alignment="CENTER_RIGHT" style="-fx-font-size: 15; -fx-font-weight: bold;"/>
    </HBox>

    <Region VBox.vgrow="ALWAYS" minHeight="50"/>

    <!-- Totals -->
    <VBox spacing="10" alignment="TOP_RIGHT" style="-fx-padding: 20 40; -fx-background-color: #f9fafb;">
        <HBox spacing="20" alignment="CENTER_RIGHT">
            <Label text="Sous-total" style="-fx-text-fill: #6b7280;"/>
            <Label fx:id="labelSubtotal" text="0.00 €" prefWidth="100" alignment="CENTER_RIGHT"/>
        </HBox>
        <HBox spacing="20" alignment="CENTER_RIGHT">
            <Label text="TVA (0%)" style="-fx-text-fill: #6b7280;"/>
            <Label text="0.00 €" prefWidth="100" alignment="CENTER_RIGHT"/>
        </HBox>
        <Separator/>
        <HBox spacing="20" alignment="CENTER_RIGHT">
            <Label text="TOTAL" style="-fx-font-size: 20; -fx-font-weight: 800;"/>
            <Label fx:id="labelTotal" text="0.00 €" prefWidth="120" alignment="CENTER_RIGHT" style="-fx-font-size: 20; -fx-font-weight: 900; -fx-text-fill: #0d1210;"/>
        </HBox>
    </VBox>

    <!-- Footer -->
    <VBox alignment="CENTER" spacing="10" style="-fx-padding: 30 40; -fx-background-color: white;">
        <Label text="Merci de choisir LAMMA pour vos aventures !" style="-fx-text-fill: #9ca3af; -fx-font-style: italic;"/>
        <HBox alignment="CENTER" spacing="20">
            <Button text="🖨 Imprimer" styleClass="btn-secondary" prefWidth="120"/>
            <Button fx:id="btnEnvoyer" text="📩 Envoyer" onAction="#onEnvoyer" styleClass="btn-secondary" prefWidth="120"/>
            <Button text="Fermer" onAction="#onClose" styleClass="btn-primary" prefWidth="120"/>
        </HBox>
    </VBox>
</VBox>
