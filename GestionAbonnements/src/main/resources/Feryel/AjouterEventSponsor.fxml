<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.*?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestion.controllers.AjouterEventSponsorController"
            fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="modern-scroll-pane">
    <stylesheets>
        <URL value="@../styles/nature-mood.css" />
        <URL value="@../styles/card-view.css" />
    </stylesheets>
    
    <StackPane style="-fx-background-color: transparent; -fx-padding: 30;">
        <VBox spacing="15" styleClass="glass-panel" prefWidth="800" maxWidth="850" alignment="TOP_CENTER" style="-fx-padding: 25;">
            
            <!-- Header Section -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane style="-fx-background-color: rgba(59, 130, 246, 0.15); -fx-background-radius: 12; -fx-padding: 10;">
                    <Label text="🔗" style="-fx-font-size: 22;"/>
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="lblTitle" text="Partenariat Événement"
                           style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: white;"/>
                    <Label text="Lier un sponsor à une expédition spécifique" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="LOGISTIQUE" style="-fx-background-color: rgba(59, 130, 246, 0.1); -fx-text-fill: #3b82f6; -fx-font-size: 10; -fx-font-weight: 900; -fx-padding: 5 12; -fx-background-radius: 15;"/>
            </HBox>

            <Separator style="-fx-opacity: 0.1;"/>

            <!-- Logistics Section -->
            <VBox spacing="15" styleClass="modern-card" style="-fx-padding: 20;">
                <Label text="📍 SÉLECTION DES ENTITÉS" style="-fx-font-weight: 900; -fx-text-fill: #3b82f6; -fx-font-size: 11; -fx-letter-spacing: 1px;"/>
                
                <GridPane hgap="15" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints minWidth="130" prefWidth="140"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Événement Cible:" style="-fx-text-fill: #94a3b8; -fx-font-weight: 700; -fx-font-size: 11;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <ComboBox fx:id="cboEvenement" promptText="Choisir un événement..." styleClass="modern-input" prefWidth="600" style="-fx-font-size: 12;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Sponsor Officiel:" style="-fx-text-fill: #94a3b8; -fx-font-weight: 700; -fx-font-size: 11;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <ComboBox fx:id="cboSponsor" promptText="Choisir un sponsor..." styleClass="modern-input" prefWidth="600" style="-fx-font-size: 12;" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                </GridPane>
            </VBox>

            <!-- Details Section -->
            <VBox spacing="15" styleClass="modern-card" style="-fx-padding: 20;">
                <Label text="💎 DÉTAILS DU PARTENARIAT" style="-fx-font-weight: 900; -fx-text-fill: #22c55e; -fx-font-size: 11; -fx-letter-spacing: 1px;"/>
                
                <GridPane hgap="15" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints minWidth="130" prefWidth="140"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Niveau de Support:" style="-fx-text-fill: #94a3b8; -fx-font-weight: 700; -fx-font-size: 11;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <ComboBox fx:id="cboNiveau" promptText="Ex: Gold, Silver..." styleClass="modern-input" prefWidth="600" style="-fx-font-size: 12;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Contribution (DT):" style="-fx-text-fill: #94a3b8; -fx-font-weight: 700; -fx-font-size: 11;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtMontant" promptText="0.00" styleClass="modern-input" style="-fx-font-size: 12;" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                </GridPane>
            </VBox>

            <!-- Status & Feedback -->
            <VBox spacing="15" styleClass="modern-card" style="-fx-padding: 15;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="ÉTAT DU DOSSIER" style="-fx-font-weight: 900; -fx-text-fill: #F97316; -fx-font-size: 10;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblMessage" text="" style="-fx-font-size: 11;"/>
                </HBox>
            </VBox>

            <!-- Actions Section -->
            <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
                <Button text="Retour" onAction="#onRetour" styleClass="button-capsule-glass" style="-fx-padding: 12 25; -fx-font-size: 12;"/>
                <Button fx:id="btnSubmit" text="CONFIRMER" onAction="#onEnregistrer" 
                        styleClass="button-capsule" style="-fx-padding: 12 40; -fx-font-size: 12;"/>
            </HBox>

        </VBox>
    </StackPane>
</ScrollPane>
